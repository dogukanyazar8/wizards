# Prisma validates migration checksums from the migration SQL bytes. Keep the
# UAT baseline byte-stable on Windows and Linux deployment workers.
packages/db/prisma/rebaseline-migrations/**/migration.sql text eol=lf

# Graphify writes generated JSON from Windows tooling. Normalize it before it
# enters history so diff and hook checks remain platform-neutral.
graphify-out/** text eol=lf

# GitHub-hosted Linux executes these scripts directly through Bash.
.github/scripts/*.sh text eol=lf

# Unified diffs encode empty context lines as one required space. Preserve those
# bytes in the pinned Auth.js patch without relaxing checks for source files.
patches/@auth__core@0.41.3.patch whitespace=-blank-at-eol
patches/@livekit__react-native-webrtc@144.1.2.patch whitespace=-blank-at-eol

# Preserve the checksum-reviewed upstream license byte-for-byte.
apps/desktop/src-tauri/vendor/glib/LICENSE whitespace=-blank-at-eof
