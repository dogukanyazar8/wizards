{
  "schemaVersion": 1,
  "profiles": {
    "Fast": {
      "description": "Validate staged whitespace, GitHub Actions workflows, toolchain contracts, and staged index formatting and lint.",
      "estimatedImpact": "No build, database, emulator, or network mutation.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "executable", "name": "git" },
        { "type": "executable", "name": "pnpm" },
        { "type": "executable", "name": "node" }
      ],
      "steps": [
        {
          "id": "fast-index-diff",
          "executable": "git",
          "arguments": ["diff", "--cached", "--check"]
        },
        { "id": "fast-actionlint", "executable": "pnpm", "arguments": ["actionlint"] },
        { "id": "fast-toolchain", "executable": "pnpm", "arguments": ["test:toolchain"] },
        {
          "id": "fast-staged-prettier",
          "executable": "node",
          "arguments": ["scripts/quality/prettier-changed.mjs", "--staged"]
        },
        {
          "id": "fast-staged-eslint",
          "executable": "node",
          "arguments": ["scripts/quality/staged-eslint.mjs"]
        }
      ]
    },
    "Standard": {
      "description": "Run root lint, typecheck, changed-file formatting, and tests.",
      "estimatedImpact": "May generate Prisma client artifacts but does not migrate, reset, deploy, or start services.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "executable", "name": "pnpm" }
      ],
      "steps": [
        { "id": "standard-lint", "executable": "pnpm", "arguments": ["lint"] },
        { "id": "standard-typecheck", "executable": "pnpm", "arguments": ["typecheck"] },
        { "id": "standard-format", "executable": "pnpm", "arguments": ["format"] },
        { "id": "standard-tests", "executable": "pnpm", "arguments": ["test"] }
      ]
    },
    "CI": {
      "description": "Run only the existing root CI aggregate boundary.",
      "estimatedImpact": "Runs the repository CI aggregate; it is not a GitHub Actions replica.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "executable", "name": "pnpm" }
      ],
      "steps": [{ "id": "ci-aggregate", "executable": "pnpm", "arguments": ["run", "ci"] }]
    },
    "Mobile": {
      "description": "Run existing mobile environment, test, quality, and release checks without creating an APK.",
      "estimatedImpact": "Does not run Expo prebuild, Gradle, Metro, or an Android build.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "path", "path": "apps/mobile/package.json" },
        { "type": "executable", "name": "pnpm" }
      ],
      "steps": [
        {
          "id": "mobile-validate-env",
          "executable": "pnpm",
          "arguments": ["--filter", "@wizards/mobile", "validate:env"]
        },
        {
          "id": "mobile-tests",
          "executable": "pnpm",
          "arguments": ["--filter", "@wizards/mobile", "test"]
        },
        {
          "id": "mobile-component-tests",
          "executable": "pnpm",
          "arguments": ["--filter", "@wizards/mobile", "test:components"]
        },
        {
          "id": "mobile-release-check",
          "executable": "pnpm",
          "arguments": ["--filter", "@wizards/mobile", "release:check"]
        },
        {
          "id": "mobile-quality-check",
          "executable": "pnpm",
          "arguments": ["--filter", "@wizards/mobile", "quality:check"]
        }
      ]
    },
    "Desktop": {
      "description": "Run desktop script, Rust formatting, lint, and locked unit-test checks without building or signing an installer.",
      "estimatedImpact": "May compile Rust test targets but does not build an installer, sign artifacts, publish, or launch the desktop app.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "path", "path": "apps/desktop/src-tauri/Cargo.toml" },
        { "type": "executable", "name": "pnpm" },
        { "type": "executable", "name": "cargo" }
      ],
      "steps": [
        {
          "id": "desktop-script-tests",
          "executable": "pnpm",
          "arguments": ["--filter", "@wizards/desktop", "test"]
        },
        {
          "id": "desktop-rust-format",
          "executable": "cargo",
          "arguments": [
            "fmt",
            "--manifest-path",
            "apps/desktop/src-tauri/Cargo.toml",
            "--all",
            "--",
            "--check"
          ]
        },
        {
          "id": "desktop-rust-lint",
          "executable": "pnpm",
          "arguments": ["--filter", "@wizards/desktop", "lint:rust"]
        },
        {
          "id": "desktop-rust-tests",
          "executable": "cargo",
          "arguments": ["test", "--locked", "--manifest-path", "apps/desktop/src-tauri/Cargo.toml"]
        }
      ]
    },
    "MobileRelease": {
      "description": "Delegate a build-only release APK to the canonical Android UAT script.",
      "estimatedImpact": "Builds a release APK in the canonical managed UAT root; it may perform canonical managed dependency recovery, but does not install to a device or start Metro.",
      "preconditions": [
        { "type": "repository" },
        { "type": "path", "path": "apps/mobile/scripts/build-android-uat.ps1" },
        { "type": "executable", "name": "powershell" }
      ],
      "steps": [
        {
          "id": "android-uat-release",
          "executable": "powershell",
          "arguments": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "apps/mobile/scripts/build-android-uat.ps1",
            "-BuildType",
            "release",
            "-SkipInstall",
            "-SkipUninstall",
            "-NoStartMetro"
          ]
        }
      ]
    },
    "Security": {
      "description": "Run the platform-independent E2E password fallback guard.",
      "estimatedImpact": "Read-only source scan; no service, database, or deployment action.",
      "preconditions": [
        { "type": "repository" },
        { "type": "path", "path": "scripts/quality/e2e-password-guard.mjs" },
        { "type": "executable", "name": "node" }
      ],
      "steps": [
        {
          "id": "security-e2e-password-guard",
          "executable": "node",
          "arguments": ["scripts/quality/e2e-password-guard.mjs"]
        }
      ]
    },
    "E2ESmoke": {
      "description": "Run the existing smoke E2E entrypoint against already-running local dependencies.",
      "estimatedImpact": "Read-only TCP prerequisite checks, then E2E test execution; it never starts services or resets data.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "executable", "name": "pnpm" },
        { "type": "environment", "name": "E2E_TEST_PASSWORD" },
        {
          "type": "loopbackTcpEnvironment",
          "name": "E2E_DATABASE_URL",
          "fallbackName": "DATABASE_URL"
        },
        { "type": "loopbackTcpEnvironment", "name": "REDIS_URL" }
      ],
      "steps": [{ "id": "e2e-smoke", "executable": "pnpm", "arguments": ["e2e:smoke"] }]
    },
    "E2EApi": {
      "description": "Run the existing API E2E entrypoint against already-running local dependencies.",
      "estimatedImpact": "Read-only TCP prerequisite checks, then E2E test execution; it never starts services or resets data.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "executable", "name": "pnpm" },
        { "type": "environment", "name": "E2E_TEST_PASSWORD" },
        {
          "type": "loopbackTcpEnvironment",
          "name": "E2E_DATABASE_URL",
          "fallbackName": "DATABASE_URL"
        },
        { "type": "loopbackTcpEnvironment", "name": "REDIS_URL" }
      ],
      "steps": [{ "id": "e2e-api", "executable": "pnpm", "arguments": ["e2e:api"] }]
    },
    "E2ERealtime": {
      "description": "Run the existing realtime E2E entrypoint against already-running local dependencies.",
      "estimatedImpact": "Read-only TCP prerequisite checks, then E2E test execution; it never starts services or resets data.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "executable", "name": "pnpm" },
        { "type": "environment", "name": "E2E_TEST_PASSWORD" },
        {
          "type": "loopbackTcpEnvironment",
          "name": "E2E_DATABASE_URL",
          "fallbackName": "DATABASE_URL"
        },
        { "type": "loopbackTcpEnvironment", "name": "REDIS_URL" }
      ],
      "steps": [{ "id": "e2e-realtime", "executable": "pnpm", "arguments": ["e2e:realtime"] }]
    },
    "E2EFull": {
      "description": "Reset and seed a dedicated local E2E database, then run the complete existing Chromium Playwright entrypoint.",
      "estimatedImpact": "Destructively resets only an explicitly named loopback E2E database and clears matching local E2E Redis state.",
      "preconditions": [
        { "type": "repository" },
        { "type": "nodeModules" },
        { "type": "executable", "name": "pnpm" },
        { "type": "environment", "name": "E2E_TEST_PASSWORD" },
        { "type": "destructiveE2EDatabase", "name": "E2E_DATABASE_URL" },
        { "type": "loopbackTcpEnvironment", "name": "REDIS_URL" }
      ],
      "steps": [
        { "id": "e2e-full-seed", "executable": "pnpm", "arguments": ["e2e:seed"] },
        { "id": "e2e-full-playwright", "executable": "pnpm", "arguments": ["e2e"] }
      ]
    }
  }
}
