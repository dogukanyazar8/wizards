{
  "name": "wizards",
  "private": true,
  "version": "0.8.15",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:clear-auth-rate-limits": "pnpm --filter @wizards/web dev:clear-auth-rate-limits",
    "build": "turbo build",
    "ci": "pnpm audit --audit-level moderate && pnpm test:toolchain && pnpm format && pnpm lint && pnpm typecheck && pnpm typecheck:main:ci && pnpm typecheck:compat && pnpm typecheck:declarations && pnpm test:coverage && pnpm build",
    "e2e": "turbo e2e --filter @wizards/web",
    "e2e:api": "turbo e2e:api --filter @wizards/web",
    "e2e:realtime": "turbo e2e:realtime --filter @wizards/web",
    "e2e:seed": "pnpm --filter @wizards/web e2e:seed",
    "e2e:smoke": "turbo e2e:smoke --filter @wizards/web",
    "lint": "turbo lint",
    "maintenance:cleanup-reauth": "pnpm --filter @wizards/web maintenance:cleanup-reauth",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage --filter @wizards/web",
    "test:toolchain": "node --test scripts/quality/*.test.mjs",
    "typecheck": "pnpm db:generate && turbo typecheck",
    "typecheck:main": "node scripts/quality/typescript-typecheck-runner.mjs --compiler=main",
    "typecheck:main:ci": "node scripts/quality/typescript-typecheck-runner.mjs --compiler=main --checkers=1",
    "typecheck:compat": "node scripts/quality/typescript-typecheck-runner.mjs --compiler=compat",
    "typecheck:declarations": "node scripts/quality/typescript-declaration-parity.mjs",
    "format": "node scripts/quality/prettier-changed.mjs",
    "db:generate": "turbo db:generate",
    "contributors:sync": "pnpm --filter @wizards/db contributors:sync"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "prettier": "3.9.5",
    "turbo": "2.10.6",
    "typescript": "catalog:"
  }
}
