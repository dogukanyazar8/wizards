{
  "name": "wizards",
  "private": true,
  "version": "0.8.0",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "effect": "^3.21.2",
      "postcss": "^8.5.13",
      "svix": "^1.92.2"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit --audit-level moderate",
    "e2e": "turbo e2e",
    "e2e:seed": "pnpm --filter @wizards/web e2e:seed",
    "e2e:smoke": "turbo e2e:smoke",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "db:generate": "turbo db:generate",
    "contributors:sync": "pnpm --filter @wizards/db contributors:sync"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.9.8",
    "typescript": "^5.8.3"
  }
}
