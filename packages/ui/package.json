{
  "name": "@wizards/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./platform-keyboard.mjs": "./src/platform-keyboard.mjs",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "node ../../scripts/quality/typescript-project-runner.mjs --project=ui --mode=build",
    "dev": "node ../../scripts/quality/typescript-project-runner.mjs --project=ui --mode=watch",
    "lint": "node ../../scripts/quality/typescript-project-runner.mjs --project=ui --mode=check",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "node ../../scripts/quality/typescript-project-runner.mjs --project=ui --mode=check",
    "format": "node ../../scripts/quality/prettier-changed.mjs --scope packages/ui"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
