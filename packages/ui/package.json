{
  "name": "@wizards/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.json",
    "dev": "tsc6 --watch --preserveWatchOutput",
    "lint": "tsc6 --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc6 --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "prettier": "3.9.5",
    "tsx": "^4.22.4",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
