{
  "name": "@wizards/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ../../scripts/quality/typescript-project-runner.mjs --project=types --mode=build",
    "dev": "node ../../scripts/quality/typescript-project-runner.mjs --project=types --mode=watch",
    "lint": "node ../../scripts/quality/typescript-project-runner.mjs --project=types --mode=check",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "node ../../scripts/quality/typescript-project-runner.mjs --project=types --mode=check",
    "format": "node ../../scripts/quality/prettier-changed.mjs --scope packages/types"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
