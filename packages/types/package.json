{
  "name": "@wizards/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc6 -p tsconfig.json",
    "dev": "tsc6 --watch --preserveWatchOutput",
    "lint": "tsc6 --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc6 --noEmit",
    "format": "node ../../scripts/quality/prettier-changed.mjs --scope packages/types"
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "3.9.5",
    "tsx": "^4.22.4",
    "typescript": "catalog:"
  }
}
