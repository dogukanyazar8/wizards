model UserServerSettings {
  id                   String              @id @default(uuid())
  userId               String
  serverId             String
  /// 6c "Yıldızla": pins the server to the top of the rail. A device-local
  /// flag would disagree between a phone and the web client, so it lives here
  /// and syncs. The row is created lazily, so "no row" reads as `false`.
  starred              Boolean             @default(false)
  muted                Boolean             @default(false)
  mutedUntil           DateTime?
  messageNotifications MessageNotification @default(DEFAULT)
  mobilePush           Boolean             @default(true)
  suppressEveryone     Boolean             @default(false)
  suppressRoles        Boolean             @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation("ServerUserSettings", fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

model DMConversation {
  id            String           @id @default(uuid())
  type          ConversationType @default(DM)
  name          String?
  iconUrl       String?
  ownerId       String?
  /// 2c §5. Free text the members read in the group info sheet.
  description   String?          @db.VarChar(120)
  /// 2c §2, Mesajlar karar #4. One of the six swatch **names**; null keeps the
  /// derived colour. Widened from `VarChar(7)` when the values stopped being hex:
  /// `primary`, `success` and `warning` are exactly seven characters, so the old
  /// width worked only by accident and the next swatch name would have been
  /// truncated in silence.
  avatarColor   String?          @db.VarChar(16)
  /// 2d §2. A real foreign key so a deleted message drops its own pin rather
  /// than leaving a dangling id for the application layer to sweep up.
  pinnedMessageId String?
  pinnedById      String?
  pinnedAt        DateTime?
  /// 2f §3. Four independent permission rows, defaulted to the values the
  /// design shows on a fresh group.
  permSendMessage   GroupPermissionLevel   @default(ALL)
  permAddMembers    GroupPermissionLevel   @default(ALL)
  permEditInfo      GroupPermissionLevel   @default(ADMINS)
  permPinMessage    GroupPermissionLevel   @default(ADMINS)
  /// 2c §7 shows "Son 30 gün" pre-selected.
  historyVisibility GroupHistoryVisibility @default(LAST_30D)
  /// K3 / Faz 2 §C1. V6: changing this never re-stamps history, it only decides
  /// what the next message is written with.
  disappearingAfter GroupDisappearingWindow @default(OFF)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())

  participants  DMParticipant[]
  messages      DMMessage[]
  /// karar #7. Many pins; `pinnedMessage` below is the single-pin predecessor.
  pinnedMessages DMPinnedMessage[]
  pinnedMessage DMMessage?      @relation("DMConversationPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)
  /// Faz 2 §B1. At most one, enforced by the unique on `GroupInvite.conversationId`.
  invite        GroupInvite?

  @@index([ownerId])
  @@index([lastMessageAt])
  @@index([pinnedMessageId])
}

model DMParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  // Newest message this participant's client has actually received. Drives the
  // second tick ("iletildi") independently of whether they opened the chat.
  lastDeliveredAt DateTime?
  mentionCount   Int       @default(0)
  muted          Boolean   @default(false)
  /// Mesajlar §17 — "Sessize al" alt menüsünün 15 dk / 1 saat / 8 saat seçenekleri.
  /// `muted` ölmedi: "Süresiz" seçimi `muted = true, mutedUntil = null` olarak yazılır, süreli
  /// seçim ikisini birlikte yazar. Okuma tarafı süresi geçmiş bir kaydı **sessiz saymaz** ve
  /// tembel temizler; ayrı bir zamanlanmış sweep yok, çünkü sessizliğin sona ermesi yalnız o
  /// konuşma okunurken anlam taşır.
  ///
  /// Index yok — üzerinde filtre çalışmaz; değer her zaman zaten okunmuş bir satırda
  /// değerlendirilir. Emsal: `UserChannelSettings.mutedUntil`, `UserServerSettings.mutedUntil`.
  mutedUntil     DateTime?
  hiddenAt       DateTime?
  unreadCount    Int       @default(0)
  /// 2e §6. OWNER duplicates `DMConversation.ownerId` on purpose: the roster
  /// query needs the role without a second read of the conversation row.
  role           DMParticipantRole @default(MEMBER)
  /// 2f §2. Authority for notifications; `muted` mirrors `notifyLevel == NONE`
  /// and the two are only ever written in the same update.
  notifyLevel    DMNotifyLevel     @default(ALL)
  /// §11.0/1. Assigned when the membership opens and fixed for its lifetime, so
  /// the client reads it rather than deriving it from a shifting member list.
  nameColor      String            @db.VarChar(7)
  /// V3 / 2a §2. This participant's own pinned conversation. Valid on 1:1 DMs.
  pinnedAt       DateTime?
  /// 2c §7. Oldest message this participant may read. Null means no floor —
  /// every member who predates the history window keeps their full history.
  historyFromAt  DateTime?
  /// 2d §2, "kapatma yalnız o kullanıcı için gizler". Holds the id of the
  /// pinned message this participant dismissed, so the next pin shows again.
  pinnedStripDismissedId String?

  conversation DMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, hiddenAt])
  @@index([userId, pinnedAt])
  @@index([conversationId, role])
}

model DMMessage {
  id                   String    @id @default(uuid())
  conversationId       String
  userId               String
  content              String    @db.Text
  replyToId            String?
  threadParentId       String?
  /// Mesajlar §6.1. A thread reply the author also published into the main
  /// conversation. Mirrors `Message.alsoSentToChannel`: without it a DM thread
  /// reply is invisible outside the panel, and the channel side already offers
  /// the choice.
  alsoSentToChannel    Boolean   @default(false)
  forwardedAt          DateTime?
  editedAt             DateTime?
  deletedAt            DateTime?
  deletedById          String?
  placeholderRemovedAt DateTime?
  /// See `Message.clientNonce`: same contract, same guarantee, per author.
  clientNonce          String?   @db.VarChar(128)
  /// Group lifecycle row. Null for a real message. `content` stays empty:
  /// the sentence is built client-side so each viewer reads their own locale.
  systemType           DMSystemMessageType?
  systemTargetUserIds  String[]             @default([])
  systemValue          String?              @db.VarChar(100)
  /// K3 / Faz 2 §C1. When the purge worker removes this row for good. NULL is
  /// permanent, which is what every message written before the window existed
  /// keeps.
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())

  conversation  DMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `dm/disappearing-service.ts` nulls replyToId inside the purge transaction;
  /// keep Restrict so cleanup has one owner instead of competing FK behavior.
  reply         DMMessage?     @relation("DMMessageReply", fields: [replyToId], references: [id], onDelete: Restrict)
  replies       DMMessage[]    @relation("DMMessageReply")
  threadParent  DMMessage?     @relation("DMMessageThreadParent", fields: [threadParentId], references: [id], onDelete: Cascade)
  threadReplies DMMessage[]    @relation("DMMessageThreadParent")
  attachments   Attachment[]   @relation("DMMessageAttachment")
  reactions     DMReaction[]
  mentions      DMMessageMention[]
  /// Back-relation for `DMConversation.pinnedMessage`. Always zero or one row.
  pinnedInConversations DMConversation[] @relation("DMConversationPinnedMessage")
  /// karar #7. The multi-pin successor of the row above.
  pins                  DMPinnedMessage[]
  /// karar #1. Zero or one; a poll message carries no text of its own.
  poll                  Poll?

  content_search Unsupported("tsvector")? @map("content_search")

  @@index([conversationId, createdAt])
  @@index([conversationId, threadParentId, createdAt])
  /// The transcript's whole predicate once thread replies can surface in it.
  @@index([conversationId, alsoSentToChannel, createdAt])
  @@index([conversationId, placeholderRemovedAt])
  @@index([threadParentId, createdAt])
  @@index([userId])
  /// The purge sweep's whole predicate. Without it the worker scans every DM
  /// message once a minute.
  @@index([expiresAt])
  /// `messages/search-service.ts:426` uses ILIKE/regex over content. The audit
  /// migration owns its pg_trgm GIN index because Prisma cannot express the
  /// required operator class here.
  @@unique([userId, clientNonce])
}

/// Faz 2 §B1 / K2. A group's one shareable link. `conversationId` is unique on
/// purpose: the design has a single link and "yenile" rotates it in place, so a
/// second concurrent invite cannot appear by accident.
///
/// `enabled = false` keeps the row but makes the code unusable; E2 ("kapalı
/// davet = kod yok") is enforced above this by never returning the code while
/// the switch is off.
model GroupInvite {
  id             String    @id @default(uuid())
  code           String    @unique @db.VarChar(12)
  conversationId String    @unique
  createdById    String
  enabled        Boolean   @default(false)
  uses           Int       @default(0)
  maxUses        Int?
  expiresAt      DateTime?
  /// Stamped by "yenile"; the previous code stops resolving the moment it moves.
  rotatedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation DMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creator      User           @relation(fields: [createdById], references: [id], onDelete: Cascade)

  /// No separate index on `code` or `conversationId`: both uniques already are
  /// b-tree indexes and a duplicate would only cost writes.
  @@index([createdById])
}

model DMReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  emojiName String?
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())

  message DMMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

/// Mesajlar paketi karar #7. A DM or group conversation may pin many messages,
/// the way a channel already can (`PinnedMessage`).
///
/// `DMConversation.pinnedMessageId` is the single-pin predecessor. It is left in
/// place for one release: this migration copies its rows here and the write path
/// stops touching it, but dropping a column in the same release that stops
/// writing it leaves no way back if a reader was missed.
model DMPinnedMessage {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String
  pinnedById     String
  pinnedAt       DateTime @default(now())

  conversation DMConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      DMMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User           @relation(fields: [pinnedById], references: [id], onDelete: Cascade)

  /// Pinning the same message twice is the same pin, not a second one.
  @@unique([conversationId, messageId])
  /// The strip reads "newest first, capped"; this is that whole query.
  @@index([conversationId, pinnedAt])
  @@index([messageId])
  @@index([pinnedById])
}

/// Mesajlar paketi karar #1. A structured poll, replacing the markdown-in-content
/// poll whose votes were emoji reactions.
///
/// The old shape could not answer three questions the design asks: who may see
/// the voters (an emoji reaction is public to everyone), what a single-choice
/// vote means (a reaction never moves), and when voting closes.
///
/// `dmMessageId` and `messageId` are both nullable and exactly one is set — the
/// migration adds a CHECK constraint, because Prisma cannot express it. Channel
/// polls are not built in this package; the column exists so adding them later
/// is a route handler and not a migration of every existing poll.
model Poll {
  id          String   @id @default(uuid())
  dmMessageId String?  @unique
  messageId   String?  @unique
  createdById String
  question    String   @db.VarChar(300)
  multi       Boolean  @default(false)
  /// Default on: the design ships the toggle enabled, and the safer default for
  /// a vote is the one that reveals less.
  anonymous   Boolean  @default(true)
  /// Resolved instant, not the "1 saat / 24 saat / 3 gün" the composer offered.
  /// Storing the unit too would be a second answer to "is this poll closed".
  closesAt    DateTime
  createdAt   DateTime @default(now())

  options   PollOption[]
  votes     PollVote[]
  dmMessage DMMessage?  @relation(fields: [dmMessageId], references: [id], onDelete: Cascade)
  message   Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  creator   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([closesAt])
}

model PollOption {
  id       String @id @default(uuid())
  pollId   String
  /// 0-based; the composer's A/B/C tiles and the card's order both read it.
  position Int
  label    String @db.VarChar(80)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, position])
}

/// One row per (option, voter).
///
/// Single-choice polls are enforced above this by deleting the voter's rows for
/// the poll and inserting the new one under a transaction-scoped advisory lock
/// for `(pollId, userId)`. The unique on `(optionId, userId)` cannot express
/// "at most one row per poll" without also breaking multi-choice.
model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  /// Reading "what did I vote" and tallying a poll are both this index.
  @@index([pollId, userId])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  campaignId String?
  dedupeKey  String?
  type       NotificationType
  title      String
  body       String
  imageUrl   String?
  read       Boolean          @default(false)
  readAt     DateTime?
  actionUrl  String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([dedupeKey])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([campaignId])
  /// `notifications/service.ts:133` filters unread rows then orders createdAt.
  @@index([userId, read, createdAt])
}

model MobilePushToken {
  id               String   @id @default(uuid())
  userId           String
  sessionKey       String   @unique
  token            String   @unique
  tokenFingerprint String
  platform         String   @db.VarChar(16)
  provider         String   @db.VarChar(16)
  registeredAt     DateTime @default(now())
  lastSeenAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OutboxJob {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique
  type           String    @db.VarChar(80)
  status         String    @default("PENDING") @db.VarChar(20)
  payload        Json
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([status, updatedAt])
  @@index([type, status])
  @@index([lockedAt])
}

model NotificationCampaign {
  id          String                     @id @default(uuid())
  type        NotificationType           @default(SYSTEM)
  title       String
  body        String
  imageUrl    String?
  actionUrl   String?
  segment     Json?
  status       NotificationCampaignStatus @default(DRAFT)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  /// The moment the recipient list was frozen. Null means the campaign has not
  /// entered delivery yet; a retry never re-resolves the segment once it is set.
  frozenAt     DateTime?
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  sentCount    Int                        @default(0)
  failedCount  Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  creator       User?              @relation("NotificationCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy    User?              @relation("NotificationCampaignApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  notifications Notification[]
  deliveries    CampaignDelivery[]
  pushAttempts  PushDeliveryAttempt[] @relation("PushDeliveryAttemptCampaign")

  @@index([status, createdAt])
  @@index([createdById])
}

/// One row per person per campaign. The record that makes delivery idempotent:
/// written when the list is frozen, consumed by the send loop.
model CampaignDelivery {
  id         String                 @id @default(uuid())
  campaignId String
  userId     String
  status     CampaignDeliveryStatus @default(PENDING)
  skipReason CampaignSkipReason?
  error      String?                @db.VarChar(280)
  sentAt     DateTime?
  createdAt  DateTime               @default(now())

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User                 @relation("CampaignDeliveryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([userId, status, sentAt])
}

model Contributor {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Set when an operator links the credit line to a real account; that link is what
  /// the `contributor` badge grant reads. Null keeps the historical name-only rows.
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation("ContributorUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([userId])
}

/// Kazanılmış rozet. DERIVED rozetler burada satır tutmaz — onlar okuma anında
/// User satırından hesaplanır. Satır silinmez; iptal `revokedAt` ile işaretlenir,
/// çünkü "bir zamanlar kazanmıştı" bilgisi moderasyon için gerekir.
model UserBadge {
  id           String      @id @default(uuid())
  userId       String
  badge        String      @db.VarChar(32)
  tier         Int         @default(1)
  source       BadgeSource
  earnedAt     DateTime    @default(now())
  /// Yalnız GRANTED rozetlerde dolu (event). Okuma yolunda filtrelenir.
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokeReason String?     @db.VarChar(280)
  grantedById  String?
  grantReason  String?     @db.VarChar(280)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user      User  @relation("UserBadgeOwner", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("UserBadgeGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, badge])
  @@index([userId, revokedAt])
  @@index([badge, tier])
}

/// Değerlendiricinin sayacı. Okuma yolunda ASLA okunmaz; yalnız "Rozetlerim"
/// ekranı ve değerlendiricinin kendisi okur.
model UserBadgeProgress {
  userId         String
  badge          String    @db.VarChar(32)
  /// Kümülatif ölçüm (gün sayısı, davet sayısı, saniye…). BigInt çünkü
  /// voiceSeconds toplamı Int sınırını aşabilir.
  value          BigInt    @default(0)
  /// Yalnız `streak` kullanır; gün atlanınca 1'e döner.
  streakDays     Int       @default(0)
  /// Aynı günün ikinci kez sayılmasını engelleyen UTC gün başlangıcı.
  lastCountedDay DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badge])
}

model Emoji {
  id          String   @id @default(uuid())
  serverId    String
  name        String
  imageUrl    String
  animated    Boolean  @default(false)
  available   Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([serverId])
}

model Webhook {
  id          String   @id @default(uuid())
  channelId   String
  serverId    String
  name        String
  avatarUrl   String?
  token       String   @unique
  createdById String
  createdAt   DateTime @default(now())

  channel Channel @relation("ChannelWebhooks", fields: [channelId], references: [id], onDelete: Cascade)
  server  Server  @relation("ServerWebhooks", fields: [serverId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([serverId])
}

model AuditLog {
  id         String              @id @default(uuid())
  serverId   String
  userId     String
  targetId   String?
  targetType AuditLogTargetType?
  action     String
  reason     String?
  changes    Json?
  createdAt  DateTime            @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@index([userId])
}

model VoiceState {
  id               String    @id @default(uuid())
  userId           String    @unique
  channelId        String
  serverId         String
  sessionId        String
  lastHeartbeat    DateTime  @default(now())
  deaf             Boolean   @default(false)
  mute             Boolean   @default(false)
  selfDeaf         Boolean   @default(false)
  selfMute         Boolean   @default(false)
  selfStream       Boolean   @default(false)
  selfVideo        Boolean   @default(false)
  suppress         Boolean   @default(false)
  requestToSpeakAt DateTime?
  joinedAt         DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation("ChannelVoiceStates", fields: [channelId], references: [id], onDelete: Cascade)
  server  Server  @relation("VoiceStateServer", fields: [serverId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([serverId])
  @@index([lastHeartbeat])
  @@index([serverId, lastHeartbeat])
}

model ScheduledEvent {
  id               String                   @id @default(uuid())
  serverId         String
  channelId        String?
  creatorId        String
  name             String
  description      String?
  imageUrl         String?
  scheduledStartAt DateTime
  scheduledEndAt   DateTime?
  status           ScheduledEventStatus     @default(SCHEDULED)
  entityType       ScheduledEventEntityType
  externalLocation String?
  /// K1 — still named `interestedCount`, but its meaning is now narrower: **going**.
  /// Renaming it would have broken three readers (Ana Sayfa feed, server public profile,
  /// mobile events endpoints) for a word; `maybeCount` is its twin.
  interestedCount  Int                      @default(0)
  createdAt        DateTime                 @default(now())

  /// K2 — presentation kind. Backfilled from `entityType` on migration.
  kind             ScheduledEventKind       @default(MEETING)
  /// K3 — non-members see it and Keşfet lists it. `serverId` stays required: a nullable FK
  /// would open a second branch and a second ownership rule in every read path.
  isPublic         Boolean                  @default(false)
  /// K6 — RRULE text. The occurrence generator is **not** in this package; the card derives
  /// its label from this rule through i18n. TODO(api): recurrence generator.
  recurrenceRule   String?                  @db.VarChar(255)
  /// K1 — the twin of `interestedCount`.
  maybeCount       Int                      @default(0)

  server    Server                   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel   Channel?                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator   User                     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  interests ScheduledEventInterest[]
  reminders ScheduledEventReminder[]

  @@index([serverId])
  @@index([scheduledStartAt])
  /// The profile card asks one question: the next SCHEDULED event of this
  /// server at or after now, ordered by start. `[serverId]` alone would make
  /// that a filter-and-sort over every past event the server ever had.
  @@index([serverId, status, scheduledStartAt])
  /// K3 — the public feed branch reads time-ordered without a membership filter.
  @@index([isPublic, status, scheduledStartAt])
}

/// `interestedCount` on its own cannot be idempotent: a second "Hatırlat" tap
/// from the same user would increment it again. This row is the uniqueness
/// the counter borrows -- the write only touches the counter when the insert
/// or delete actually changed something.
model ScheduledEventInterest {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  /// K1 — the RSVP answer moved onto this row instead of into a second table: one table,
  /// one unique key, no two counters to drift apart. Rows written before the migration
  /// carried "I'm going" intent, so the default is already the truth.
  status    ScheduledEventRsvpStatus @default(GOING)

  event ScheduledEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  /// The "Katılacağım" tab and the `mine` filter both read this.
  @@index([userId, status])
}

/// K5 — one reminder preference per viewer per event. Delivery rides `OutboxJob`
/// (`availableAt = startsAt − minutesBefore`); this row is only the preference.
model ScheduledEventReminder {
  id            String   @id @default(uuid())
  eventId       String
  userId        String
  /// The design offers 5 / 10 / 15 / 30 / 60; 10 is what both the RSVP strip and the detail
  /// panel promise in their own copy.
  minutesBefore Int      @default(10)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event ScheduledEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

enum ClientHealthKind {
  STARTUP
  SCREEN_LOAD
  CRASH
  ERROR
  API_LATENCY
}

/// Raw client health signals. Kept apart from `UserDailyMetric` because the
/// shape, the volume and the retention are all different: these arrive in
/// bursts and are rolled up into `ClientHealthDailySummary` after 30 days.
model ClientHealthEvent {
  id         String              @id @default(uuid())
  userId     String?
  clientType AnalyticsClientType @default(UNKNOWN)
  appVersion String?             @db.VarChar(32)
  os         String?             @db.VarChar(32)
  kind       ClientHealthKind
  surface    String?             @db.VarChar(64)
  valueMs    Int?
  context    Json?
  /// Stamped per measurement by the client. Unique so a retried flush cannot
  /// count the same sample twice.
  sampleId   String?             @unique @db.VarChar(64)
  createdAt  DateTime            @default(now())

  user User? @relation("ClientHealthEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([clientType, kind, createdAt])
  @@index([appVersion, kind, createdAt])
  /// `telemetry/client-health-rollup.ts` runs bare createdAt cutoff sweeps.
  @@index([createdAt])
}

/// What survives the 30-day rollup: counts and latency percentiles per day,
/// platform, version and kind.
model ClientHealthDailySummary {
  id         String              @id @default(uuid())
  date       DateTime            @db.Date
  clientType AnalyticsClientType @default(UNKNOWN)
  /// Empty string when the client did not report one: a NULL here would make
  /// every rollup row distinct under the unique index and duplicate the summary.
  appVersion String              @default("") @db.VarChar(32)
  kind       ClientHealthKind
  /// Empty string for kinds that have no surface (crashes, errors). Part of the
  /// unique key: a percentile pooled across surfaces is not actionable.
  surface    String              @default("") @db.VarChar(64)
  count      Int                 @default(0)
  p50Ms      Int?
  p95Ms      Int?
  p99Ms      Int?
  createdAt  DateTime            @default(now())

  @@unique([date, clientType, appVersion, kind, surface])
  @@index([date, kind])
}

model FeatureFlag {
  key            String                @id @db.VarChar(64)
  description    String?               @db.VarChar(280)
  enabled        Boolean               @default(false)
  /// Empty means every platform. Otherwise only the listed ones.
  clientTypes    AnalyticsClientType[]
  /// 0-100. Stable per user through a hash of the key and the user id.
  rolloutPercent Int                   @default(100)
  updatedById    String?
  updatedAt      DateTime              @updatedAt
  createdAt      DateTime              @default(now())

  updatedBy User? @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

enum PushAttemptStage {
  TICKET
  RECEIPT
}

model PushDeliveryAttempt {
  id             String           @id @default(uuid())
  userId         String?
  campaignId     String?
  notificationId String?
  platform       String           @db.VarChar(16)
  stage          PushAttemptStage @default(TICKET)
  /// Expo ticket id; a receipt lookup is matched through it.
  ticketId       String?          @db.VarChar(64)
  success        Boolean
  errorCode      String?          @db.VarChar(64)
  createdAt      DateTime         @default(now())

  user     User?                 @relation("PushDeliveryAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  campaign NotificationCampaign? @relation("PushDeliveryAttemptCampaign", fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId, success])
  @@index([platform, stage, createdAt])
  @@index([errorCode, createdAt])
  @@index([ticketId])
}

enum ClusterSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A proposal, never an action: clustering suggests which feedback rows look
/// like the same request, and an operator decides. Nothing here links a
/// `Feedback` to a roadmap item on its own.
model FeedbackClusterSuggestion {
  id           String                  @id @default(uuid())
  topic        FeedbackTopic
  feedbackIds  Json
  score        Float                   @default(0)
  status       ClusterSuggestionStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime                @default(now())

  resolvedBy User? @relation("FeedbackClusterResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, score])
  @@index([topic, createdAt])
}

/// Which build stream a release belongs to. `UAT` is an internal stream, so it
/// is never the default a new account lands on.
enum ReleaseChannel {
  STABLE
  UAT
}

enum ReleaseChangeType {
  NEW
  IMPROVED
  FIXED
}

enum MobileUpdatePlatform {
  ANDROID
  IOS
}

enum ReleaseArtifactKind {
  APK
  AAB
  IPA
}

enum DownloadPlatform {
  WINDOWS
  MACOS
  LINUX
  ANDROID
  IOS
}

/// Kartin dugme ikonunu belirler: STORE dis baglanti oku, digerleri indirme oku.
enum DownloadDelivery {
  DIRECT
  STORE
  TESTFLIGHT
}

/// "Whispr'i indir" penceresinin katalogu (SPEC-INDIRME §B).
///
/// `ReleaseArtifact`ten bilerek ayri durur: o tablo mobil OTA zincirine bagli
/// (`MobileUpdatePlatform`, `OtaBundle`, `@@unique([platform, kind, channel,
/// versionCode])`) ve oraya masaustu satiri sokmak guncelleme yolunu riske
/// atardi. Bu tablo yalniz "indir" penceresini besler.
///
/// `publishedAt = NULL` taslaktir ve hicbir kullanici ucu dondurmez -- `Release`
/// modelindeki sozlesmenin aynisi.
model DownloadArtifact {
  id               String           @id @default(uuid())
  /// STABLE = PROD (Stable), UAT = UAT (Beta).
  channel          ReleaseChannel
  platform         DownloadPlatform
  delivery         DownloadDelivery
  url              String           @db.VarChar(2048)
  /// `.exe`, `.AppImage · .deb`, `Play Store`. Iki dil: her yayinda kod degismesin diye
  /// i18n sozlugune degil, yonetim konsoluna ait bir metin.
  extensionLabelTr String           @db.VarChar(120)
  extensionLabelEn String           @db.VarChar(120)
  /// Kartin tek satirlik meta metni: isletim sistemi, mimari, boyut.
  metaLabelTr      String           @db.VarChar(120)
  metaLabelEn      String           @db.VarChar(120)
  versionLabel     String           @db.VarChar(32)
  buildLabel       String?          @db.VarChar(32)
  sizeBytes        BigInt?
  sha256           String?          @db.VarChar(64)
  releasedAt       DateTime
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /// Bir ortamda bir platformun tek guncel satiri olur; pencere ayni karti iki kez cizemez.
  @@unique([channel, platform])
  @@index([channel, publishedAt])
}

enum HelpCategory {
  ACCOUNT
  CHAT
  MEDIA
  SERVER
}

enum BugReportCategory {
  VOICE
  CHAT
  NOTIFICATION
  PERFORMANCE
  OTHER
}

enum BugReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISCARDED
}

/// One shipped app version. The "Yenilikler" card, the release history and the
/// update banner all read this table, so a version the team has not announced
/// yet must stay invisible rather than live behind a client-side filter:
/// `publishedAt = NULL` is a draft and no mobile endpoint returns it.
model Release {
  id          String         @id @default(uuid())
  /// Semver text, for example "0.8.15". Unique because the detail route and the
  /// installed-version comparison both address a release by it.
  version     String         @unique @db.VarChar(32)
  codename    String?        @db.VarChar(48)
  channel     ReleaseChannel @default(STABLE)
  releasedAt  DateTime
  buildNumber Int?
  /// Download size of the build. BigInt in the column, plain number on the wire.
  sizeBytes   BigInt?
  /// The paragraph 2a prints under the version heading.
  summary     String?        @db.VarChar(600)
  /// One line for the history row; shorter than `summary` on purpose.
  highlight   String?        @db.VarChar(160)
  mandatory   Boolean        @default(false)
  /// Old native builds below this code must install a new binary before OTA.
  minSupportedVersionCode Int?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  artifacts  ReleaseArtifact[]
  changes    ReleaseChange[]
  otaBundles OtaBundle[]

  @@index([publishedAt, releasedAt])
  @@index([channel, releasedAt])
}

/// Immutable, pre-signed Expo update publication metadata. The signing private
/// key is deliberately absent: publication signs offline before this row exists.
model OtaBundle {
  id                         String               @id @default(uuid())
  releaseId                  String
  platform                   MobileUpdatePlatform
  channel                    ReleaseChannel
  runtimeVersion             String               @db.VarChar(256)
  bundleKey                  String               @unique @db.VarChar(512)
  manifestBody               String
  manifestSignature          String
  manifestSha256             String               @db.VarChar(64)
  noUpdateDirectiveBody      String
  noUpdateDirectiveSignature String
  rollbackDirectiveBody      String
  rollbackDirectiveSignature String
  signingKeyId               String               @db.VarChar(128)
  rolloutPercentage          Int                  @default(100)
  enabled                    Boolean              @default(true)
  publishedAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([platform, channel, runtimeVersion, publishedAt])
}

/// A native package registered only after CI verifies its bytes and Android
/// signing certificate. Store builds never receive an internal APK URL.
model ReleaseArtifact {
  id                String               @id @default(uuid())
  releaseId         String
  channel           ReleaseChannel
  platform          MobileUpdatePlatform
  kind              ReleaseArtifactKind
  versionCode       Int
  url               String               @db.VarChar(2048)
  sizeBytes         BigInt
  sha256            String               @db.VarChar(64)
  signingCertSha256 String?              @db.VarChar(95)
  publishedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([platform, kind, channel, versionCode])
  @@index([releaseId])
  @@index([platform, kind, channel, versionCode, publishedAt])
}

/// A single line of a release note. `position` orders within a type group, so
/// 2a can render "YENİ · 2" then "İYİLEŞTİRME · 3" without sorting on the client.
model ReleaseChange {
  id        String            @id @default(uuid())
  releaseId String
  type      ReleaseChangeType
  title     String            @db.VarChar(200)
  detail    String?           @db.VarChar(600)
  position  Int               @default(0)

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, type, position])
}

/// A help centre entry. `bodyMarkdown` is optional: when it is empty the app
/// opens `url` in a browser instead of the in-app reader, which is what keeps
/// a long-form article from having to be duplicated here.
model HelpArticle {
  id           String       @id @default(uuid())
  slug         String       @unique @db.VarChar(120)
  title        String       @db.VarChar(200)
  category     HelpCategory
  readMinutes  Int
  viewCount    Int          @default(0)
  url          String       @db.VarChar(2048)
  bodyMarkdown String?
  publishedAt  DateTime?
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category, position])
  @@index([publishedAt, viewCount])
}

/// 2f "Sorun bildir". Deliberately separate from `Feedback`: that table is a
/// product suggestion queue with a roadmap and a public number the user tracks,
/// while this one carries logs, a screenshot and device details under a 90-day
/// deletion promise the screen makes in writing.
model BugReport {
  id                  String            @id @default(uuid())
  /// `WSP-#####`, quoted back in the submission toast and searched by support.
  ticket              String            @unique @db.VarChar(16)
  userId              String?
  category            BugReportCategory
  body                String            @db.VarChar(1000)
  includesLogs        Boolean
  includesScreenshot  Boolean
  includesDeviceInfo  Boolean
  /// Trimmed to the last 500 lines before it is stored; §4.10 promises no more.
  logExcerpt          String?
  /// Only written when `includesDeviceInfo` is true.
  deviceInfo          Json?
  screenshotUrl       String?           @db.VarChar(2048)
  appVersion          String?           @db.VarChar(32)
  appBuild            String?           @db.VarChar(32)
  releaseChannel      String?           @db.VarChar(16)
  platform            String?           @db.VarChar(16)
  status              BugReportStatus   @default(OPEN)
  createdAt           DateTime          @default(now())
  /// `createdAt + 90 days`. The purge job reads this column, so the promise is
  /// data rather than a rule someone has to remember.
  purgeAfter          DateTime

  user User? @relation("BugReportUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([purgeAfter])
  @@index([userId, createdAt])
}
