/// Keşfet's "POPÜLER KANALLAR" lane reports the last 24 hours of activity
/// (karar K2). A live `COUNT(*)` would scan `Message` on every page load of a
/// browsing surface, so an hourly job fills one row per channel per hour and the
/// lane reads only from here. `windowStart` is the top of the hour in UTC.
///
/// The table starts empty and is not backfilled: until the first hourly run the
/// lane shows its empty state, which is a true statement about a rollup that has
/// not run yet — not an error.
model DiscoverChannelActivity {
  channelId    String
  windowStart  DateTime
  messageCount Int      @default(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, windowStart])
  /// The lane sums the trailing 24 windows and orders by volume; leading with
  /// `windowStart` lets Postgres cut the range before it looks at any count.
  @@index([windowStart, messageCount])
}

