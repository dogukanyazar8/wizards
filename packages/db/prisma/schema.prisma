// =============================================================================
// GENERATOR & DATASOURCE
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  /// Without this, an `include` graph becomes one query per relation: the
  /// message page pulls author, attachments, reactions, reaction users and the
  /// reply separately — five round trips for one page. With it, Prisma emits a
  /// single statement using LATERAL joins.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

// User status types - represents user's PREFERENCE only, not real-time state
enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
  INVISIBLE
}

// Notification channel types
enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  STAGE
  FORUM
  THREAD
  DM
  GROUP_DM
}

// Notification types
enum NotificationType {
  MENTION
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  DM
  SERVER_INVITE
  SYSTEM
  MODERATION
  // Feedback status changes. Its own type rather than SYSTEM so the mobile tap
  // handler can route to the tracking view without sniffing metadata, and so a
  // user can mute product updates without losing security notices.
  FEEDBACK
}

enum FeedbackRating {
  BAD
  OKAY
  GOOD
  GREAT
}

enum FeedbackTopic {
  SUGGESTION
  BUG
  VOICE
  PERFORMANCE
  OTHER
}

/// Shared by Feedback and RoadmapItem: a linked pair always reads the same
/// status, so the roadmap row and the submitter's tracking card cannot disagree.
enum FeedbackStatus {
  REVIEWING
  PLANNED
  IN_PROGRESS
  SHIPPED
}

// Server verification levels
enum VerificationLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

// Explicit content filter levels
enum ExplicitContentFilter {
  DISABLED
  MEMBERS_WITHOUT_ROLES
  ALL_MEMBERS
}

// User explicit content filter levels
enum UserExplicitContentFilter {
  DISABLED
  FRIENDS
  ALL
}

// Friend request policies
enum FriendRequestPolicy {
  EVERYONE
  MUTUAL_SERVERS
  MUTUAL_FRIENDS
  NOBODY
}

// DM policies
enum DmPolicy {
  EVERYONE
  FRIENDS
  MUTUAL_SERVERS
  NOBODY
}

// Device types for sessions
enum DeviceType {
  WEB
  DESKTOP
  MOBILE
}

enum AdminRole {
  OWNER
  ADMIN
  SUPPORT
  ANALYST
  MODERATOR
}

enum AnalyticsClientType {
  WEB
  DESKTOP
  MOBILE
  UNKNOWN
}

enum AnalyticsDeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

enum AnalyticsMediaKind {
  VOICE
  CAMERA
  SCREEN_SHARE
}

enum NotificationCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum CampaignSkipReason {
  FREQUENCY_CAP
  NOT_DELIVERABLE
  OPTED_OUT
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum MobileMediaUploadPurpose {
  PROFILE_AVATAR
  PROFILE_BANNER
  SERVER_ICON
  // 4a screenshots. Owner-scoped like the profile purposes; claimed by the
  // feedback submission rather than by the generic profile claim route.
  FEEDBACK_ATTACHMENT
}

// Sticker animation preferences
enum AnimateStickers {
  ALWAYS
  INTERACTION
  NEVER
}

// Notification level preferences
enum NotificationLevel {
  ALL_MESSAGES
  ONLY_MENTIONS
}

// Friend request status
enum UserReportReason {
  HARASSMENT
  SPAM
  INAPPROPRIATE
  IMPERSONATION
  OTHER
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
  APPEALED
  CLOSED
}

enum ModerationCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ModerationEventKind {
  REPORT_ADDED
  NOTE
  STATUS_CHANGED
  ASSIGNED
  ACTION_TAKEN
  APPEAL_OPENED
  APPEAL_RESOLVED
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// Server boost levels
enum PremiumType {
  NONE
  BASIC
  FULL
}

// Message types
enum MessageType {
  DEFAULT
  REPLY
  THREAD_STARTER
  SYSTEM_JOIN
  SYSTEM_LEAVE
  SYSTEM_PINNED
  CALL
}

// Video quality modes
enum VideoQualityMode {
  AUTO
  FULL
}

// Message notification levels
enum MessageNotification {
  ALL
  MENTIONS
  NOTHING
  DEFAULT
}

// Permission override target types
enum PermissionTargetType {
  USER
  ROLE
}

// DM conversation types
enum ConversationType {
  DM
  GROUP_DM
}

// Audit log target types
enum AuditLogTargetType {
  USER
  CHANNEL
  ROLE
  SERVER
  MESSAGE
}

// Scheduled event statuses
enum ScheduledEventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Scheduled event entity types
enum ScheduledEventEntityType {
  STAGE
  VOICE
  EXTERNAL
}

// =============================================================================
// MODELS
// =============================================================================

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  username              String      @unique
  // Null until the first username change; drives the 30-day change cooldown.
  usernameChangedAt     DateTime?
  displayName           String?
  passwordHash          String?
  avatarUrl             String?
  avatarHash            String?
  bannerUrl             String?
  bannerColor           String?
  bannerOffsetX         Float?
  bannerOffsetY         Float?
  bio                   String?     @db.VarChar(500)
  pronouns              String?
  status                UserStatus  @default(OFFLINE)
  customStatus          String?
  customStatusEmoji     String?
  customStatusExpiresAt DateTime?
  theme                 String      @default("theme-dark")
  locale                String      @default("en")
  emailVerified         Boolean     @default(false)
  emailVerifiedAt       DateTime?
  twoFactorEnabled      Boolean     @default(false)
  twoFactorSecret       String?
  twoFactorSecretCiphertext String? @db.Text
  twoFactorSecretKeyVersion String? @db.VarChar(64)
  phoneNumber           String?
  phoneVerified         Boolean     @default(false)
  isBot                 Boolean     @default(false)
  isSystem              Boolean     @default(false)
  isBanned              Boolean     @default(false)
  bannedAt              DateTime?
  bannedReason          String?
  sessionsRevokedAfter  DateTime?
  deletedAt             DateTime?
  anonymizedAt          DateTime?
  premiumType           PremiumType @default(NONE)
  premiumSince          DateTime?
  // 2c update-channel preference. Null means "stable"; it never changes the EAS
  // channel a build was shipped on, only which stream the app offers next.
  preferredReleaseChannel ReleaseChannel?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  registeredAt          DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  accounts                Account[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  accountReauthChallenges AccountReauthChallenge[]
  twoFactorRecoveryCodes   TwoFactorRecoveryCode[]
  settings                UserSettings?
  notificationSettings    UserNotificationSettings?
  friendRequestsSent      FriendRequest[]           @relation("FriendRequestSender")
  friendRequestsReceived  FriendRequest[]           @relation("FriendRequestReceiver")
  ownedServers            Server[]                  @relation("ServerOwner")
  serverMembers           ServerMember[]
  bannedFromServers       ServerBan[]               @relation("BanUser")
  serverBans              ServerBan[]               @relation("BanModerator")
  serverInvites           ServerInvite[]
  messages                Message[]                 @relation("MessageAuthor")
  reactions               Reaction[]
  messageMentions         MessageMention[]
  pinnedMessages          PinnedMessage[]
  channelReadStates       ChannelReadState[]
  userChannelSettings     UserChannelSettings[]
  userServerSettings      UserServerSettings[]
  dmParticipants          DMParticipant[]
  dmMessages              DMMessage[]
  dmReactions             DMReaction[]
  attachments             Attachment[]
  notifications           Notification[]
  emojis                  Emoji[]
  webhooks                Webhook[]
  auditLogs               AuditLog[]
  voiceState              VoiceState?
  scheduledEvents         ScheduledEvent[]
  adminMembership         AdminMembership?          @relation("AdminMembershipUser")
  adminGrants             AdminMembership[]         @relation("AdminMembershipGrantedBy")
  adminAuditLogs          AdminAuditLog[]           @relation("AdminAuditActor")
  appSessions             AppSession[]
  dailyMetrics            UserDailyMetric[]
  mediaUsageSessions      MediaUsageSession[]
  notificationCampaigns   NotificationCampaign[]    @relation("NotificationCampaignCreator")
  approvedCampaigns       NotificationCampaign[]    @relation("NotificationCampaignApprover")
  campaignDeliveries      CampaignDelivery[]        @relation("CampaignDeliveryUser")
  mobilePushTokens        MobilePushToken[]
  reportsFiled            UserReport[]              @relation("UserReportReporter")
  reportsReceived         UserReport[]              @relation("UserReportSubject")
  moderationCasesAsSubject ModerationCase[]         @relation("ModerationCaseSubject")
  moderationCasesAsAssignee ModerationCase[]        @relation("ModerationCaseAssignee")
  moderationEvents        ModerationCaseEvent[]     @relation("ModerationCaseEventActor")
  notesWritten            UserNote[]                @relation("UserNoteAuthor")
  notesAbout              UserNote[]                @relation("UserNoteSubject")
  feedback                Feedback[]
  roadmapVotes            RoadmapVote[]
  clientHealthEvents      ClientHealthEvent[]       @relation("ClientHealthEventUser")
  featureFlagUpdates      FeatureFlag[]             @relation("FeatureFlagUpdatedBy")
  pushDeliveryAttempts    PushDeliveryAttempt[]     @relation("PushDeliveryAttemptUser")
  feedbackClustersResolved FeedbackClusterSuggestion[] @relation("FeedbackClusterResolver")
  bugReports              BugReport[]               @relation("BugReportUser")

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([premiumType])
  @@index([deletedAt])
}

model AdminMembership {
  id          String    @id @default(uuid())
  userId      String    @unique
  role        AdminRole @default(ANALYST)
  grantedById String?
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User  @relation("AdminMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("AdminMembershipGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([grantedById])
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminUserId   String?
  action        String
  targetType    String?
  targetId      String?
  reason        String?
  metadata      Json?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())

  adminUser User? @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model AppSession {
  id              String              @id @default(uuid())
  userId          String
  sessionKey      String              @unique
  startedAt       DateTime            @default(now())
  lastSeenAt      DateTime            @default(now())
  endedAt         DateTime?
  durationSeconds Int                 @default(0)
  clientType      AnalyticsClientType @default(WEB)
  deviceType      AnalyticsDeviceType @default(UNKNOWN)
  appVersion      String?             @db.VarChar(32)
  /// True only when the client identified itself through `x-whispr-client`.
  /// False rows carry a guessed clientType and are reported as UNKNOWN.
  attributionVerified Boolean         @default(false)
  os              String?
  browser         String?
  countryCode     String?             @db.VarChar(2)
  userAgentHash   String?
  ipHash          String?
  socketId        String?
  endReason       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([lastSeenAt])
  @@index([clientType])
  @@index([clientType, startedAt])
  @@index([countryCode])
}

model UserDailyMetric {
  id                 String   @id @default(uuid())
  userId             String
  date               DateTime
  appSeconds         Int      @default(0)
  messageCount       Int      @default(0)
  dmMessageCount     Int      @default(0)
  fileUploadCount    Int      @default(0)
  uploadedBytes      BigInt   @default(0)
  voiceSeconds       Int      @default(0)
  cameraSeconds      Int      @default(0)
  screenShareSeconds Int      @default(0)
  sessionCount       Int      @default(0)
  /// UNKNOWN means the row predates client attribution, or the client never
  /// identified itself. Reports keep it as its own bucket instead of folding it
  /// into WEB, which would fake a platform shift on the migration day.
  clientType         AnalyticsClientType @default(UNKNOWN)
  /// Last version seen that day. Deliberately outside the unique key: splitting
  /// a day on an in-day update would scatter the daily totals.
  appVersion         String?             @db.VarChar(32)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId, clientType])
  @@index([date])
  @@index([userId, date])
  @@index([date, clientType])
}

model MediaUsageSession {
  id              String             @id @default(uuid())
  userId          String
  serverId        String?
  channelId       String?
  sessionId       String
  kind            AnalyticsMediaKind
  clientType      AnalyticsClientType @default(UNKNOWN)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationSeconds Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server  Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([serverId, channelId, startedAt])
  @@index([sessionId, kind, endedAt])
  @@index([kind, startedAt])
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String   @map("type")
  provider          String   @map("provider")
  providerAccountId String   @map("provider_account_id")
  refreshToken      String?  @map("refresh_token") @db.Text
  accessToken       String?  @map("access_token") @db.Text
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?  @map("scope")
  idToken           String?  @map("id_token") @db.Text
  sessionState      String?  @map("session_state")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserSettings {
  id                    String                    @id @default(uuid())
  userId                String                    @unique
  theme                 String                    @default("theme-dark")
  locale                String                    @default("en")
  messageDisplayCompact Boolean                   @default(false)
  developerMode         Boolean                   @default(false)
  showCurrentGame       Boolean                   @default(true)
  inlineAttachmentMedia Boolean                   @default(true)
  inlineEmbedMedia      Boolean                   @default(true)
  renderEmbeds          Boolean                   @default(true)
  renderReactions       Boolean                   @default(true)
  messageFont           String                    @default("outfit")
  // Messaging redesign §3: the message body carries its own four-step size
  // preference so it can be synced across devices. Deliberately separate from
  // `messageDisplayCompact`, which is the web's compact message layout — these
  // three only affect the mobile DM/channel message body.
  messageBodySize             String              @default("medium")
  messageBodyCompact          Boolean             @default(false)
  messageBodyFollowSystemFont Boolean             @default(false)
  animateEmoji          Boolean                   @default(true)
  animateStickers       AnimateStickers           @default(INTERACTION)
  enableTTS             Boolean                   @default(true)
  defaultNotifications  NotificationLevel         @default(ALL_MESSAGES)
  explicitContentFilter UserExplicitContentFilter @default(DISABLED)
  friendRequestPolicy   FriendRequestPolicy       @default(EVERYONE)
  dmPolicy              DmPolicy                  @default(FRIENDS)
  showReadReceipts      Boolean                   @default(true)
  nsfwAllowed           Boolean                   @default(false)
  serverRailWidth       Int                       @default(136)
  channelSidebarWidth   Int                       @default(288)
  notificationLimit     Int                       @default(5)
  notificationAutoClose Boolean                   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotificationSettings {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  desktopNotifications     Boolean   @default(true)
  mobileNotifications      Boolean   @default(true)
  emailNotifications       Boolean   @default(false)
  notificationSound        Boolean   @default(true)
  notificationSoundFile    String    @default("default")
  suppressEveryoneMentions Boolean   @default(false)
  suppressRoleMentions     Boolean   @default(false)
  mutedUntil               DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String     @id @default(uuid())
  userId       String
  token        String     @unique @map("token")
  refreshToken String     @unique @map("refresh_token")
  ipAddress    String?
  userAgent    String?
  deviceType   DeviceType @default(WEB)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountReauthChallenge {
  id        String    @id @default(cuid())
  userId    String
  purpose   String    @db.VarChar(64)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// 11a "Bildir" flow. Profile reports are grouped into moderation cases; content
// evidence is deliberately deferred to D2 because the report contract has no source id.
model UserReport {
  id         String           @id @default(uuid())
  reporterId String
  subjectId  String
  reason     UserReportReason
  details    String?          @db.VarChar(500)
  caseId     String?
  createdAt  DateTime         @default(now())

  reporter User @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subject  User @relation("UserReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  case     ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  evidence ModerationEvidence[]

  @@index([subjectId, createdAt])
  @@index([reporterId, createdAt])
  @@index([caseId])
}

model ModerationCase {
  id              String                 @id @default(uuid())
  publicNumber    Int                    @unique @default(autoincrement())
  subjectId       String?
  subjectHandle   String                 @db.VarChar(64)
  status          ModerationCaseStatus   @default(OPEN)
  priority        ModerationCasePriority @default(NORMAL)
  assigneeId      String?
  reportCount     Int                    @default(0)
  summary         String?                @db.VarChar(280)
  resolution      String?                @db.VarChar(1000)
  openedAt        DateTime               @default(now())
  firstSeenAt     DateTime?
  resolvedAt      DateTime?
  evidencePurgeAt DateTime?
  updatedAt       DateTime               @updatedAt

  subject  User?                  @relation("ModerationCaseSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  assignee User?                  @relation("ModerationCaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reports  UserReport[]
  events   ModerationCaseEvent[]
  evidence ModerationEvidence[]

  @@index([status, priority, openedAt])
  @@index([assigneeId, status])
  @@index([subjectId, status])
  @@index([evidencePurgeAt])
}

model ModerationCaseEvent {
  id        String              @id @default(uuid())
  caseId    String
  actorId   String?
  kind      ModerationEventKind
  body      String?             @db.VarChar(1000)
  metadata  Json?
  createdAt DateTime            @default(now())

  case  ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User?          @relation("ModerationCaseEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

model ModerationEvidence {
  id           String   @id @default(uuid())
  caseId       String
  reportId     String?
  messageId    String?
  dmMessageId  String?
  attachmentId String?
  snapshot     Json
  capturedAt   DateTime @default(now())

  case   ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  report UserReport?    @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([caseId, capturedAt])
  @@index([reportId])
}

// 11e private note (handoff 2b). Readable and writable by its author only: the
// subject is never told a note exists, so no query path may join from subjectId
// alone. One note per (author, subject) pair — saving replaces, clearing deletes.
model UserNote {
  id        String   @id @default(uuid())
  authorId  String
  subjectId String
  body      String   @db.VarChar(256)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User @relation("UserNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("UserNoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([authorId, subjectId])
  @@index([authorId])
}

/// Handoff 4a/4b product feedback. `publicNumber` is a serial the UI renders as
/// `WSP-{n}`: the submitter quotes it, support searches it, and it stays short
/// and stable in a way a uuid never could.
model Feedback {
  id            String         @id @default(uuid())
  publicNumber  Int            @unique @default(autoincrement())
  userId        String
  rating        FeedbackRating
  topic         FeedbackTopic
  message       String         @db.VarChar(1000)
  /// Snapshot of exactly what the "Neler gönderilir?" sheet listed, stored as
  /// sent so a later contract change cannot rewrite what the user agreed to.
  diagnostics   Json?
  status        FeedbackStatus @default(REVIEWING)
  roadmapItemId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  statusChangedAt DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItem RoadmapItem?         @relation(fields: [roadmapItemId], references: [id], onDelete: SetNull)
  attachments FeedbackAttachment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([topic, createdAt])
  @@index([roadmapItemId])
}

/// One screenshot on a feedback item. The row is written from a claimed
/// `MobileMediaUpload`, so the upload lifecycle (verify, claim, cleanup) stays
/// in the one service that already owns it.
model FeedbackAttachment {
  id          String   @id @default(uuid())
  feedbackId  String
  uploadId    String   @unique
  url         String
  contentType String
  width       Int
  height      Int
  sizeBytes   Int
  createdAt   DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

/// A public roadmap entry the community votes on. Feedback items link into one,
/// which is how "senin önerin" knows a row came from the viewer.
model RoadmapItem {
  id          String         @id @default(uuid())
  title       String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  versionLabel String?       @db.VarChar(24)
  status      FeedbackStatus @default(REVIEWING)
  /// Ascending display order; ties fall back to newest first.
  position    Int            @default(0)
  featured    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  feedback Feedback[]
  votes    RoadmapVote[]

  @@index([status, position])
  @@index([featured, position])
}

model RoadmapVote {
  id            String   @id @default(uuid())
  roadmapItemId String
  userId        String
  createdAt     DateTime @default(now())

  roadmapItem RoadmapItem @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roadmapItemId, userId])
  @@index([userId])
}

model FriendRequest {
  id         String       @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model Server {
  id                          String                @id @default(uuid())
  name                        String
