/// Bahsedilmeler — Dalga 0 / Ş0.2. Bir bahsetme satırının **nasıl** doğduğu.
///
/// `@herkes` bu listede yok, bilerek: kitlesel çağrı üye başına satır yazmaz, mesajın kendi
/// `mentionEveryone` bayrağından türetilir (karar K2). Üye başına satır 5.000 üyeli bir
/// sunucuda gönderim başına 5.000 yazma demekti.
enum MentionKind {
  /// `@kullanıcıadı`
  SELF
  /// `@rol` — `roleId` dolu olur.
  ROLE
  /// Takip edilen thread'e gelen yanıt.
  THREAD
}

/// `MentionState.refId`in hangi tabloyu işaret ettiği.
///
/// Dört dalın hepsi tek bir okundu/sonra oku/kaldırıldı tablosuna yazar; aksi halde "okundu"
/// dört ayrı yerde tutulur ve dördü ayrışır.
enum MentionStateSource {
  /// `MessageMention.id`
  CHANNEL
  /// `DMMessageMention.id`
  DM
  /// `Message.id` — `mentionEveryone` bayrağından türetilen bahsetme.
  EVERYONE
  /// `Message.id` — takip edilen thread'e gelen yanıt.
  THREAD
}

/// Masaüstü bildirim kipi (SPEC-BAHSEDILMELER §7 segmenti).
///
/// `UserNotificationSettings.desktopNotifications` boolean'ının yerini alır; eski alan bir
/// sürüm daha durur ve `OFF` ↔ `false` eşlenir.
enum DesktopMentionMode {
  ALL
  MENTIONS
  OFF
}

/// Ayarlar paketi K3 — "Hangi bildirimleri al" ekseni (560 px pencerenin üç radyo kartı ve
/// Ayarlar › Bildirimler › Genel'deki `b1` satırı **aynı** kolonu yazar).
///
/// `UserSettings.defaultNotifications` (`ALL_MESSAGES` / `ONLY_MENTIONS`) bu eksenin iki
/// basamaklı atasıdır ve kanal varsayılanı olarak yaşamaya devam eder; bu kolon kullanıcının
/// **kendi** bildirim düzeyidir ve üçüncü basamağı (`OFF`) taşır.
enum NotificationLevelPreference {
  ALL
  IMPORTANT
  OFF
}

/// Sistem (tarayıcı / işletim sistemi) bildirimi kipi — referans `nd2`.
///
/// `DesktopMentionMode` ile aynı üç üyeyi taşır ama ayrı bir tiptir: o alan bahsetme hattının
/// masaüstü kipidir, bu alan bildirim merkezinin teslim kanalıdır. Geri doldurma ikisini bir
/// kez eşler (§1.5), sonrasında ayrı yaşarlar.
enum SystemNotificationMode {
  ALL
  MENTIONS
  OFF
}

/// Ses paleti — `public/sounds/` altındaki iki takım. `WHISPR` `*-whispr.mp3`, `CLASSIC`
/// eki olmayan klasik dosyadır.
enum SoundProfile {
  WHISPR
  CLASSIC
}

/// K5 — "Son güvenlik etkinlikleri" satırının sekiz kaynağı. Liste kapalıdır: karşılığı olan
/// bir yazıcı olmadan üye eklenmez, yoksa ekran hiç dolmayacak bir tür gösterir.
enum SecurityEventKind {
  LOGIN_NEW_DEVICE
  PASSWORD_CHANGED
  FAILED_LOGIN
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  SESSION_REVOKED
  RECOVERY_CODES_REGENERATED
  EMAIL_CHANGED
}

/// Bir thread takibinin **neden** doğduğu (karar K3).
///
/// Örtük üç yol otomatiktir; `EXPLICIT` kullanıcının kendi açtığı takiptir. `mutedAt` dolu bir
/// satır örtük kurallarla yeniden açılmaz — kullanıcı bilerek kapatmıştır.
enum ThreadFollowOrigin {
  AUTHOR
  REPLY
  MENTION
  EXPLICIT
}

// Permission override target types
enum PermissionTargetType {
  USER
  ROLE
}

// DM conversation types
enum ConversationType {
  DM
  GROUP_DM
}

enum DMSystemMessageType {
  GROUP_CREATED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_LEFT
  NAME_CHANGED
  ICON_CHANGED
  /// K3 / Faz 2 §C2. The one settings change loud enough to announce.
  /// `systemValue` carries the new window.
  DISAPPEARING_CHANGED
}

// Group DM roles. A conversation has exactly one OWNER, mirrored by
// `DMConversation.ownerId`; ADMIN is the delegated tier 2e §6 draws a chip for.
enum DMParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

// 2f §2. The authority for notification behaviour; `DMParticipant.muted` is its
// derived mirror and the two are always written together.
enum DMNotifyLevel {
  ALL
  MENTIONS
  NONE
}

// 2f §3. The only two answers the permission rows offer.
enum GroupPermissionLevel {
  ALL
  ADMINS
}

// 2c §7. How much history a member who joins now may read.
//
// Mesajlar paketi (karar #9) adds LAST_7D because the new group-create screen
// offers "7 gün". LAST_24H stays: existing conversations carry it and the group
// settings panel still offers it — the create screen simply does not draw it.
enum GroupHistoryVisibility {
  NONE
  LAST_24H
  LAST_7D
  LAST_30D
  ALL
}

// K3 / Faz 2 §C1. How long a message written from now on survives.
enum GroupDisappearingWindow {
  OFF
  H24
  D7
  D90
}

// Audit log target types
enum AuditLogTargetType {
  USER
  CHANNEL
  ROLE
  SERVER
  MESSAGE
}

// Scheduled event statuses
enum ScheduledEventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Scheduled event entity types
enum ScheduledEventEntityType {
  STAGE
  VOICE
  EXTERNAL
}

/// Etkinlikler Ş0.2 / K2 — the event's **presentation** kind, which is what the card, the
/// week-strip dot and the create modal all draw. `ScheduledEventEntityType` stays the
/// technical binding (stage / voice / external): six presentation kinds squeezed into three
/// technical ones leave "is game night voice or external" unanswered, and the `Yayına katıl`
/// CTA with nowhere to go.
enum ScheduledEventKind {
  VOICE
  MEETING
  GAME
  LIVE
  COMMUNITY
  WORKSHOP
}

/// K1 — an RSVP answer. Absence of an answer is the absence of the row, not a third member.
enum ScheduledEventRsvpStatus {
  GOING
  MAYBE
}

enum ServerType {
  PERSONAL
  COMMUNITY
}

/// Keşfet dizininin tek sınıflandırma ekseni (karar K1). Deliberately not derived
/// from `Server.tags`: a tag list is owner-authored and unbounded, so a server
/// carrying both "oyun" and "destek" would land in two categories at once and the
/// per-category counters would stop summing to the total.
enum ServerCategory {
  OYUN
  IS
  CALISMA
  KISISEL
  DESTEK
}

/// Which layer wrote a badge row. DERIVED badges never persist a row — the value is
/// recomputed from the User row on read — so the enum value exists only for grants
/// that later migrate between layers, keeping the column honest about its author.
enum BadgeSource {
  DERIVED
  AWARDED
  GRANTED
}

// =============================================================================
// MODELS
// =============================================================================

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  username              String      @unique
  // Null until the first username change; drives the 30-day change cooldown.
  usernameChangedAt     DateTime?
  displayName           String?
  passwordHash          String?
  avatarUrl             String?
  avatarHash            String?
  bannerUrl             String?
  bannerColor           String?
  bannerOffsetX         Float?
  bannerOffsetY         Float?
  bio                   String?     @db.VarChar(500)
  status                UserStatus  @default(OFFLINE)
  customStatus          String?
  customStatusEmoji     String?
  customStatusExpiresAt DateTime?
  /// Ana Sayfa 1a, Faz 3. End of a timed focus window. Null means focus is off.
  statusExpiresAt       DateTime?
  /// Status to return to when the focus window ends. Written from the live
  /// `status` when focus opens, so re-opening focus never overwrites it.
  statusRestoreTo       UserStatus?
  /// Length the window was opened with. `statusExpiresAt` alone cannot answer
  /// "how far through is it" after a reload, and the card draws a ring.
  statusFocusMinutes    Int?
  theme                 String      @default("theme-dark")
  locale                String      @default("en")
  emailVerified         Boolean     @default(false)
  emailVerifiedAt       DateTime?
  twoFactorEnabled      Boolean     @default(false)
  twoFactorSecret       String?
  twoFactorSecretCiphertext String? @db.Text
  twoFactorSecretKeyVersion String? @db.VarChar(64)
  phoneNumber           String?
  phoneVerified         Boolean     @default(false)
  isBot                 Boolean     @default(false)
  isSystem              Boolean     @default(false)
  isBanned              Boolean     @default(false)
  bannedAt              DateTime?
  bannedReason          String?
  sessionsRevokedAfter  DateTime?
  deletedAt             DateTime?
  anonymizedAt          DateTime?
  premiumType           PremiumType @default(NONE)
  premiumSince          DateTime?
  // 2c update-channel preference. Null means "stable"; it never changes the EAS
  // channel a build was shipped on, only which stream the app offers next.
  preferredReleaseChannel ReleaseChannel?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  registeredAt          DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  accounts                Account[]
  sessions                Session[]
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  accountReauthChallenges AccountReauthChallenge[]
  emailChangeChallenge EmailChangeChallenge?
  twoFactorRecoveryCodes   TwoFactorRecoveryCode[]
  settings                UserSettings?
  notificationSettings    UserNotificationSettings?
  friendRequestsSent      FriendRequest[]           @relation("FriendRequestSender")
  friendRequestsReceived  FriendRequest[]           @relation("FriendRequestReceiver")
  ownedServers            Server[]                  @relation("ServerOwner")
  serverMembers           ServerMember[]
  bannedFromServers       ServerBan[]               @relation("BanUser")
  emailVerificationCodes  EmailVerificationCode[]
  serverBans              ServerBan[]               @relation("BanModerator")
  serverAuthorizationSubjectRevisions ServerAuthorizationSubjectRevision[]
  serverInvites           ServerInvite[]
  groupInvites            GroupInvite[]
  messages                Message[]                 @relation("MessageAuthor")
  reactions               Reaction[]
  messageMentions         MessageMention[]
  dmMessageMentions       DMMessageMention[]
  mentionStates           MentionState[]
  threadFollows           ThreadFollow[]
  pinnedMessages          PinnedMessage[]
  channelReadStates       ChannelReadState[]
  userChannelSettings     UserChannelSettings[]
  userServerSettings      UserServerSettings[]
  dmParticipants          DMParticipant[]
  dmMessages              DMMessage[]
  dmReactions             DMReaction[]
  dmPinnedMessages        DMPinnedMessage[]
  polls                   Poll[]
  pollVotes               PollVote[]
  attachments             Attachment[]
  notifications           Notification[]
  emojis                  Emoji[]
  webhooks                Webhook[]
  auditLogs               AuditLog[]
  voiceState              VoiceState?
  scheduledEvents         ScheduledEvent[]
  scheduledEventInterests ScheduledEventInterest[]
  scheduledEventReminders ScheduledEventReminder[]
  adminMembership         AdminMembership?          @relation("AdminMembershipUser")
  adminGrants             AdminMembership[]         @relation("AdminMembershipGrantedBy")
  adminAuditLogs          AdminAuditLog[]           @relation("AdminAuditActor")
  appSessions             AppSession[]
  dailyMetrics            UserDailyMetric[]
  mediaUsageSessions      MediaUsageSession[]
  notificationCampaigns   NotificationCampaign[]    @relation("NotificationCampaignCreator")
  approvedCampaigns       NotificationCampaign[]    @relation("NotificationCampaignApprover")
  campaignDeliveries      CampaignDelivery[]        @relation("CampaignDeliveryUser")
  mobilePushTokens        MobilePushToken[]
  reportsFiled            UserReport[]              @relation("UserReportReporter")
  reportsReceived         UserReport[]              @relation("UserReportSubject")
  moderationCasesAsSubject ModerationCase[]         @relation("ModerationCaseSubject")
  moderationCasesAsAssignee ModerationCase[]        @relation("ModerationCaseAssignee")
  moderationEvents        ModerationCaseEvent[]     @relation("ModerationCaseEventActor")
  notesWritten            UserNote[]                @relation("UserNoteAuthor")
  notesAbout              UserNote[]                @relation("UserNoteSubject")
  feedback                Feedback[]
  roadmapVotes            RoadmapVote[]
  clientHealthEvents      ClientHealthEvent[]       @relation("ClientHealthEventUser")
  featureFlagUpdates      FeatureFlag[]             @relation("FeatureFlagUpdatedBy")
  pushDeliveryAttempts    PushDeliveryAttempt[]     @relation("PushDeliveryAttemptUser")
  feedbackClustersResolved FeedbackClusterSuggestion[] @relation("FeedbackClusterResolver")
  bugReports              BugReport[]               @relation("BugReportUser")
  badges                  UserBadge[]               @relation("UserBadgeOwner")
  badgeGrants             UserBadge[]               @relation("UserBadgeGranter")
  badgeProgress           UserBadgeProgress[]
  contributorEntries      Contributor[]             @relation("ContributorUser")
  securityEvents          SecurityEvent[]

  /// `friends/service.ts:670` searches both fields with case-insensitive
  /// `contains`. The audit migration owns direct-column pg_trgm indexes because
  /// Prisma emits ILIKE for that filter and cannot express gin_trgm_ops here.
  @@index([status])
  @@index([premiumType])
  @@index([deletedAt])
  /// The focus sweep asks one question every minute: which rows have a window
  /// that already closed. Without this it is a full scan of every account.
  @@index([statusExpiresAt])
}

model AdminMembership {
  id          String    @id @default(uuid())
  userId      String    @unique
  role        AdminRole @default(ANALYST)
  grantedById String?
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User  @relation("AdminMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("AdminMembershipGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([grantedById])
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminUserId   String?
  action        String
  targetType    String?
  targetId      String?
  reason        String?
  metadata      Json?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())

  adminUser User? @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model AppSession {
  id              String              @id @default(uuid())
  userId          String
  sessionKey      String              @unique
  startedAt       DateTime            @default(now())
  lastSeenAt      DateTime            @default(now())
  endedAt         DateTime?
  durationSeconds Int                 @default(0)
  clientType      AnalyticsClientType @default(WEB)
  deviceType      AnalyticsDeviceType @default(UNKNOWN)
  appVersion      String?             @db.VarChar(32)
  /// True only when the client identified itself through `x-whispr-client`.
  /// False rows carry a guessed clientType and are reported as UNKNOWN.
  attributionVerified Boolean         @default(false)
  os              String?
  browser         String?
  countryCode     String?             @db.VarChar(2)
  userAgentHash   String?
  ipHash          String?
  socketId        String?
  endReason       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([lastSeenAt])
  @@index([clientType])
  @@index([clientType, startedAt])
  @@index([countryCode])
  /// `friends/last-seen.ts:18` groups by user and takes max(lastSeenAt).
  @@index([userId, lastSeenAt])
  /// Admin activity and health snapshots filter on a bare startedAt range.
  @@index([startedAt])
}

/// Durable authentication-session registry shared by web, desktop, and mobile.
/// Deliberately excludes tokens, raw IP addresses, and user-agent strings.
model AuthSession {
  id          String              @id
  userId      String
  clientType  AnalyticsClientType @default(UNKNOWN)
  deviceType  AnalyticsDeviceType @default(UNKNOWN)
  os          String?             @db.VarChar(128)
  browser     String?             @db.VarChar(128)
  countryCode String?             @db.VarChar(2)
  appVersion  String?             @db.VarChar(32)
  createdAt   DateTime            @default(now())
  lastSeenAt  DateTime            @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt])
  @@index([expiresAt])
}

model UserDailyMetric {
  id                 String   @id @default(uuid())
  userId             String
  date               DateTime
  appSeconds         Int      @default(0)
  messageCount       Int      @default(0)
  dmMessageCount     Int      @default(0)
  fileUploadCount    Int      @default(0)
  uploadedBytes      BigInt   @default(0)
  voiceSeconds       Int      @default(0)
  cameraSeconds      Int      @default(0)
  screenShareSeconds Int      @default(0)
  sessionCount       Int      @default(0)
  /// UNKNOWN means the row predates client attribution, or the client never
  /// identified itself. Reports keep it as its own bucket instead of folding it
  /// into WEB, which would fake a platform shift on the migration day.
  clientType         AnalyticsClientType @default(UNKNOWN)
  /// Last version seen that day. Deliberately outside the unique key: splitting
  /// a day on an in-day update would scatter the daily totals.
  appVersion         String?             @db.VarChar(32)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId, clientType])
  @@index([date])
  @@index([userId, date])
  @@index([date, clientType])
}

model MediaUsageSession {
  id              String             @id @default(uuid())
  userId          String
  serverId        String?
  channelId       String?
  sessionId       String
  kind            AnalyticsMediaKind
  clientType      AnalyticsClientType @default(UNKNOWN)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationSeconds Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server  Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([serverId, channelId, startedAt])
  @@index([sessionId, kind, endedAt])
  @@index([kind, startedAt])
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String   @map("type")
  provider          String   @map("provider")
  providerAccountId String   @map("provider_account_id")
  refreshToken      String?  @map("refresh_token") @db.Text
  accessToken       String?  @map("access_token") @db.Text
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?  @map("scope")
  idToken           String?  @map("id_token") @db.Text
  sessionState      String?  @map("session_state")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserSettings {
  id                    String                    @id @default(uuid())
  userId                String                    @unique
  theme                 String                    @default("theme-dark")
  locale                String                    @default("en")
  messageDisplayCompact Boolean                   @default(false)
  developerMode         Boolean                   @default(false)
  showCurrentGame       Boolean                   @default(true)
  inlineAttachmentMedia Boolean                   @default(true)
  inlineEmbedMedia      Boolean                   @default(true)
  renderEmbeds          Boolean                   @default(true)
  renderReactions       Boolean                   @default(true)
  messageFont           String                    @default("outfit")
  /// Ayarlar F2 — web'in `Mesaj boyutu` kaydırıcısı (12–22 px). Mobilin dört adımlı
  /// `messageBodySize` tercihinden ayrıdır; ikisi aynı kolona sığmaz.
  messageSizePx         Int                       @default(15)
  // Messaging redesign §3: the message body carries its own four-step size
  // preference so it can be synced across devices. Deliberately separate from
  // `messageDisplayCompact`, which is the web's compact message layout — these
  // three only affect the mobile DM/channel message body.
  messageBodySize             String              @default("medium")
  messageBodyCompact          Boolean             @default(false)
  messageBodyFollowSystemFont Boolean             @default(false)
  animateEmoji          Boolean                   @default(true)
  animateStickers       AnimateStickers           @default(INTERACTION)
  enableTTS             Boolean                   @default(true)
  defaultNotifications  NotificationLevel         @default(ALL_MESSAGES)
  explicitContentFilter UserExplicitContentFilter @default(DISABLED)
  friendRequestPolicy   FriendRequestPolicy       @default(EVERYONE)
  dmPolicy              DmPolicy                  @default(FRIENDS)
  // 2b §7: "Grup davetlerine kapalı". A boolean rather than a policy enum
  // because a group add is always made by a friend — `dmPolicy`'s EVERYONE /
  // FRIENDS / NONE ladder has no third rung to offer here.
  allowGroupInvites     Boolean                   @default(true)
  showReadReceipts      Boolean                   @default(true)
  /// Mesajlar §15.5 — profil panelindeki gizlilik kartının ikinci anahtarı.
  /// `showReadReceipts` ile ikizdir: ikisi de **yayınlayan** tarafta uygulanır (kapalı tercih
  /// ağ üzerinden hiç çıkmaz), alan tarafta filtrelenmez. Kart üçüncü satır olarak şifreleme
  /// durumunu gösterir ama o satırın tercih karşılığı yoktur — salt okunurdur.
  showTypingIndicator   Boolean                   @default(true)
  profileVisibility     ProfileVisibility         @default(EVERYONE)
  presenceVisibility    PresenceVisibility        @default(EVERYONE)
  timeZone              String?
  dateFormat            UserDateFormat            @default(LOCALE)
  timeFormat            UserTimeFormat            @default(LOCALE)
  interfaceDensity      InterfaceDensity          @default(COMFORTABLE)
  /// Mesajlar §4. Default matches the screen's own default control label.
  friendsSort           FriendsSort               @default(STATUS)
  serverRailWidth       Int                       @default(136)
  channelSidebarWidth   Int                       @default(288)
  notificationLimit     Int                       @default(5)
  notificationAutoClose Boolean                   @default(true)

  /// K9 — "Boşta sayılma süresi". Tasarımın kullanıcı barı menüsünde yeri yok (menü beş
  /// satıra sabit), ama tercihin kendisi ölmez: Gizlilik › Görünürlük grubuna satır olur.
  idleTimeoutMinutes       Int     @default(10)

  /// Görünüm › Erişilebilirlik — referans `x2`, `x3`, `x4`, `x6`, `x7`.
  highContrast             Boolean @default(false)
  strongFocusRings         Boolean @default(true)
  /// `x4` kaydırıcısı, %85–130. Kök font ölçek adımından (SPEC-ANA-SAYFA §8.1) **ayrıdır**:
  /// o adım ekran boyutundan türer, bu kullanıcının kendi tercihidir.
  uiTextScale              Int     @default(100)
  screenReaderDescriptions Boolean @default(true)
  followSystemA11y         Boolean @default(true)

  /// `SPEC_DEVIATIONS` #4 — referans `Hareketi azalt` için Medya (`v7`) ve Erişilebilirlik
  /// (`x1`) sekmelerinde **ayrı** anahtar tutuyor. Aynı adlı iki kontrolün bağımsız durumu
  /// PROMPT §8 ile çelişir; iki satır bu tek kolonu yazar. Aynısı `Text-to-speech` için
  /// geçerli, orada zaten var olan `enableTTS` (`v8` = `x5`) kullanılır.
  reduceMotion             Boolean @default(false)

  /// Görünüm › Düzen — `n1` uygulama simgesi ve `y2`/`y4`/`y5`. `serverRailWidth` (`y1`) ve
  /// `channelSidebarWidth` (`y3`) zaten var.
  appIcon                  String  @default("whispr") @db.VarChar(24)
  mainContentWidth         Int     @default(100)
  serverIconSize           Int     @default(44)
  showMemberPanelByDefault Boolean @default(true)

  /// Görünüm › Medya `v2`. `v1`/`v3`/`v4` karşılıkları `inlineAttachmentMedia`,
  /// `renderEmbeds`, `renderReactions` olarak zaten duruyor.
  linkPreviews             Boolean @default(true)

  /// Ses ve Video › Ses `i6`, 0–500 ms. Cihaz tercihleri (`i1`, `u1`, `k1`) yerelde kalır;
  /// bu değer hesaba bağlıdır çünkü bas-konuş alışkanlığı cihazdan bağımsızdır.
  pttReleaseMs             Int     @default(120)

  /// K7 · `SPEC_DEVIATIONS` #11 — K3'ün ("bildirim tercihleri tipli kolon, JSON değil") **tek**
  /// istisnası. Kısayol listesi sorgulanabilir bir alan değil: "⌥H atamış kullanıcılar" diye
  /// bir filtre yok, cihaz başına bir kez okunan bir tercih paketi var. Beş eylemin her biri
  /// için bir hızlandırıcı dizesi tutar (`{"toggleMute":"Alt+M",…}`); okuma
  /// `lib/desktop/shortcuts.ts` `sanitizeDesktopShortcutAssignments` üzerinden geçer.
  ///
  /// **Çakışma durumu burada saklanmaz.** O, her açılışta kabuğun gerçek kayıt denemesinden
  /// okunur; saklanan bir çakışma, kullanıcı çakışan uygulamayı kaldırdıktan sonra da
  /// kırmızı satır göstermeye devam ederdi.
  desktopShortcuts         Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotificationSettings {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  /// Bahsedilmeler Ş0.2: `desktopMentionMode` bu alanın yerini aldı. Bir sürüm daha duruyor —
  /// yazmayı bırakan sürümle kolonu düşüren sürüm aynı olursa, kaçırılmış bir okuyucudan geri
  /// dönüş yolu kalmaz. `OFF` ↔ `false` eşlenir.
  desktopNotifications     Boolean   @default(true)
  mobileNotifications      Boolean   @default(true)
  emailNotifications       Boolean   @default(false)
  notificationSound        Boolean   @default(true)
  notificationSoundFile    String    @default("default")
  /// SPEC-BAHSEDILMELER §7 `@herkes ve @burada` anahtarının **ters** karşılığı
  /// (`suppress = true` ↔ anahtar kapalı). Ters mantık yalnız servis katmanında çözülür.
  suppressEveryoneMentions Boolean   @default(false)
  /// §7 `Rol bahsetmeleri` anahtarının ters karşılığı.
  suppressRoleMentions     Boolean   @default(false)
  mutedUntil               DateTime?

  /// §7 `Bana özel bahsetmeler`. Ters ikizleri olan iki alanın aksine doğrudan okunur; yeni
  /// alanlar ters mantığı sürdürmez.
  mentionSelf              Boolean            @default(true)
  /// §7 `Thread yanıtları` — tasarımda **kapalı** başlar. Varsayılan açık olsaydı, thread
  /// takibi (K3) yayına girdiği anda her kullanıcı beklemediği bir bildirim dalgası alırdı.
  mentionThreadReplies     Boolean            @default(false)
  /// §7 masaüstü segmenti. `MENTIONS` = `Sadece bahsetmeler`, tasarımın seçili değeri.
  desktopMentionMode       DesktopMentionMode @default(MENTIONS)

  /// §7 sessiz saatler şeridi. Sessiz saatte bahsetme **sayaca yazılır**, yalnız push ve
  /// masaüstü bildirimi bastırılır — tasarımın kendi metni bunu söylüyor.
  quietHoursEnabled        Boolean   @default(false)
  /// `HH:mm`, 24 saat. `from > to` gece aşan aralıktır (`23:00 – 08:00`).
  quietHoursFrom           String?   @db.VarChar(5)
  quietHoursTo             String?   @db.VarChar(5)
  /// Boşsa `UserAccountPreferences.timeZone`, o da boşsa `Europe/Istanbul`. Saat aralığı
  /// izleyicinin saatinde anlamlıdır; UTC'de değerlendirilirse yaz saatinde bir saat kayar.
  quietHoursTimeZone       String?

  /// Etkinlikler K7 — the bell in the events header. While `false` the header subtitle reads
  /// "takvim bağlı değil" and reminder jobs are **never** queued; a preference that is stored
  /// but not honoured would make that sentence a lie.
  eventNotifications       Boolean   @default(true)

  // -------------------------------------------------------------------------
  // Ayarlar paketi Ş0 — Bildirimler bölümünün yedi sekmesi (K3: tipli kolon, JSON değil).
  //
  // Yukarıdaki on iki kolon **korunur**. `suppressEveryoneMentions` ve `suppressRoleMentions`
  // ters mantığını sürdürür ve yalnız `mention-settings-service.ts` içinde çevrilir; aşağıdaki
  // hiçbir alan ters değildir.
  //
  // `typeSecurity` / `typeModeration` kolonu **yoktur**: kilitli iki tür sunucu tarafında
  // sabit `true` döner ve PATCH içinde gelirse 400 verir. Kolon eklemek "kilitli" iddiasını
  // yalan yapardı — kapatılamayan bir tercihin saklanacak bir değeri yok.
  // -------------------------------------------------------------------------

  /// 560 px pencerenin üç radyo kartı + Genel `b1`. `IMPORTANT` tasarımın `Önerilen` pilini
  /// taşıyan seçenektir.
  level                    NotificationLevelPreference @default(IMPORTANT)

  /// `nd2` — Genel ve Yüzeyler sekmelerinde **aynı** anahtar (tuzak #4).
  systemMode               SystemNotificationMode      @default(MENTIONS)
  /// `na6` — sistem bildiriminde gönderen ve içerik. Varsayılan kapalı: omuz üstünden okunan
  /// bir bildirim mesajın kendisini göstermemeli. `panelShowContent` (`np4`) bundan **ayrıdır**.
  systemPreview            Boolean                     @default(false)

  /// Yüzeyler › uygulama içi uyarılar — `na1`, `na2`, `na3`.
  inAppToast               Boolean                     @default(true)
  systemWhileOpen          Boolean                     @default(false)
  appBadge                 Boolean                     @default(true)

  /// Yüzeyler › teslim kanalları — `nd1`, `nd3`, `nd4`. `mobileNotifications` ve
  /// `emailNotifications` bunlara **eşlenir**; çift kaynak olmasın diye gönderim yolu bir
  /// sürüm sonra yalnız bu ikisini okur.
  deliveryInApp            Boolean                     @default(true)
  deliveryPush             Boolean                     @default(true)
  deliveryEmail            Boolean                     @default(false)

  /// Türler sekmesi — 16 satırın kolonu olan 14'ü. Varsayılanlar referans `SET` dizisinden.
  typeDm                   Boolean                     @default(true)
  typeMentionSelf          Boolean                     @default(true)
  typeMentionRole          Boolean                     @default(true)
  typeMentionEveryone      Boolean                     @default(false)
  typeThreadReplies        Boolean                     @default(true)
  typeMessageReplies       Boolean                     @default(true)
  typeIncomingCall         Boolean                     @default(true)
  typeVoiceInvite          Boolean                     @default(true)
  typeFriendRequest        Boolean                     @default(true)
  typeServerInvite         Boolean                     @default(true)
  typeEvents               Boolean                     @default(true)
  typeBadges               Boolean                     @default(false)
  typeAnnouncements        Boolean                     @default(true)
  typeProductUpdates       Boolean                     @default(false)

  /// `nq5` — sessiz saatte çağrı yine zil çalar.
  quietHoursAllowCalls     Boolean                     @default(true)

  /// Sesler sekmesi — dört satırın üçer kolonu (`ns1`–`ns4`).
  soundNotificationEnabled Boolean                     @default(true)
  soundNotificationProfile SoundProfile                @default(WHISPR)
  soundNotificationVolume  Int                         @default(60)
  soundCallEnabled         Boolean                     @default(true)
  soundCallProfile         SoundProfile                @default(CLASSIC)
  soundCallVolume          Int                         @default(80)
  soundJoinEnabled         Boolean                     @default(true)
  soundJoinProfile         SoundProfile                @default(WHISPR)
  soundJoinVolume          Int                         @default(50)
  soundLeaveEnabled        Boolean                     @default(true)
  soundLeaveProfile        SoundProfile                @default(WHISPR)
  soundLeaveVolume         Int                         @default(50)

  /// Panel sekmesi — `np1`–`np5`. `UserSettings.notificationLimit` ve
  /// `notificationAutoClose` bir sürüm daha yazılmaya devam eder.
  panelCount               Int                         @default(5)
  panelAutoClose           Boolean                     @default(true)
  panelDurationSec         Int                         @default(10)
  /// `np4` — uygulama içi açılır kartın metni. `systemPreview` sistem bildiriminin metnidir;
  /// ikisi ayrı yüzey, ayrı tercih (tuzak #4).
  panelShowContent         Boolean                     @default(false)
  panelShowSource          Boolean                     @default(true)

  /// `ne1` — yeni istisnalar için varsayılan sessize alma süresi (`1h`, `8h`, `24h`,
  /// `forever`). Segment metinleri i18n'de; kolon anahtarı taşır.
  defaultMuteDuration      String                      @default("8h") @db.VarChar(16)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// K5 — Hesabım › Güvenlik'teki "Son güvenlik etkinlikleri" bloğunun kaynağı.
///
/// Ham IP saklanmaz: `AdminAuditLog.ipHash` ile aynı tuzlu hash şeması kullanılır. Bir güvenlik
/// günlüğünün kendisi bir gizlilik yükümlülüğüdür; "hangi IP'den girdin" sorusunun cevabı
/// kullanıcıya `location` ile verilir, diske ham adres olarak değil.
model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String
  kind      SecurityEventKind
  ipHash    String?           @db.VarChar(64)
  userAgent String?
  location  String?
  metadata  Json?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Blok tek soru sorar: bu kullanıcının son kayıtları. Zaman olmadan indeks, sayfanın
  /// kendisi kadar satır okur.
  @@index([userId, createdAt])
}

model Session {
  id           String     @id @default(uuid())
  userId       String
  token        String     @unique @map("token")
  refreshToken String     @unique @map("refresh_token")
  ipAddress    String?
  userAgent    String?
  deviceType   DeviceType @default(WEB)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// The expired-session sweep introduced by audit prompt 01 filters expiresAt.
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// SPEC-GIRIS-KAYIT §4.5 — alti haneli e-posta dogrulama kodu (paket karari K3).
/// Link tabanli EmailVerificationToken **kaldirilmadi**: gonderilmis baglantilar calismaya
/// devam ediyor, iki yol da ayni dogrulama servisine baglaniyor.
model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// One pending change per account; codes and OAuth bearer tokens are never stored in plaintext.
model EmailChangeChallenge {
  userId String @id
  id String @unique
  currentEmail String
  newEmail String
  credentialStamp String
  codeHash String?
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  sentAt DateTime?
  oauthTokenHash String? @unique
  oauthVerifiedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model AccountReauthChallenge {
  id        String    @id @default(cuid())
  userId    String
  purpose   String    @db.VarChar(64)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// 11a "Bildir" flow. Profile reports are grouped into moderation cases; content
// evidence is deliberately deferred to D2 because the report contract has no source id.
model UserReport {
  id         String           @id @default(uuid())
  reporterId String
  subjectId  String
  reason     UserReportReason
  details    String?          @db.VarChar(500)
  caseId     String?
  createdAt  DateTime         @default(now())

  reporter User @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subject  User @relation("UserReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  case     ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  evidence ModerationEvidence[]

  @@index([subjectId, createdAt])
  @@index([reporterId, createdAt])
  @@index([caseId])
}

model ModerationCase {
  id              String                 @id @default(uuid())
  publicNumber    Int                    @unique @default(autoincrement())
  subjectId       String?
  subjectHandle   String                 @db.VarChar(64)
  status          ModerationCaseStatus   @default(OPEN)
  priority        ModerationCasePriority @default(NORMAL)
  assigneeId      String?
  reportCount     Int                    @default(0)
  summary         String?                @db.VarChar(280)
  resolution      String?                @db.VarChar(1000)
  openedAt        DateTime               @default(now())
  firstSeenAt     DateTime?
  resolvedAt      DateTime?
  evidencePurgeAt DateTime?
  updatedAt       DateTime               @updatedAt

  subject  User?                  @relation("ModerationCaseSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  assignee User?                  @relation("ModerationCaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reports  UserReport[]
  events   ModerationCaseEvent[]
  evidence ModerationEvidence[]

  @@index([status, priority, openedAt])
  @@index([assigneeId, status])
  @@index([subjectId, status])
  @@index([evidencePurgeAt])
}

model ModerationCaseEvent {
  id        String              @id @default(uuid())
  caseId    String
  actorId   String?
  kind      ModerationEventKind
  body      String?             @db.VarChar(1000)
  metadata  Json?
  createdAt DateTime            @default(now())

  case  ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User?          @relation("ModerationCaseEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

model ModerationEvidence {
  id           String   @id @default(uuid())
  caseId       String
  reportId     String?
  messageId    String?
  dmMessageId  String?
  attachmentId String?
  snapshot     Json
  capturedAt   DateTime @default(now())

  case   ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  report UserReport?    @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([caseId, capturedAt])
  @@index([reportId])
}

// 11e private note (handoff 2b). Readable and writable by its author only: the
// subject is never told a note exists, so no query path may join from subjectId
// alone. One note per (author, subject) pair — saving replaces, clearing deletes.
model UserNote {
  id        String   @id @default(uuid())
  authorId  String
  subjectId String
  body      String   @db.VarChar(256)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User @relation("UserNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("UserNoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([authorId, subjectId])
  @@index([authorId])
}

/// Handoff 4a/4b product feedback. `publicNumber` is a serial the UI renders as
/// `WSP-{n}`: the submitter quotes it, support searches it, and it stays short
/// and stable in a way a uuid never could.
model Feedback {
  id            String         @id @default(uuid())
  publicNumber  Int            @unique @default(autoincrement())
  userId        String
  rating        FeedbackRating
  topic         FeedbackTopic
  message       String         @db.VarChar(1000)
  /// Snapshot of exactly what the "Neler gönderilir?" sheet listed, stored as
  /// sent so a later contract change cannot rewrite what the user agreed to.
  diagnostics   Json?
  status        FeedbackStatus @default(REVIEWING)
  roadmapItemId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  statusChangedAt DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItem RoadmapItem?         @relation(fields: [roadmapItemId], references: [id], onDelete: SetNull)
  attachments FeedbackAttachment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([topic, createdAt])
  @@index([roadmapItemId])
}

/// One screenshot on a feedback item. The row is written from a claimed
/// `MobileMediaUpload`, so the upload lifecycle (verify, claim, cleanup) stays
/// in the one service that already owns it.
model FeedbackAttachment {
  id          String   @id @default(uuid())
  feedbackId  String
  uploadId    String   @unique
  url         String
  contentType String
  width       Int
  height      Int
  sizeBytes   Int
  createdAt   DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

/// A public roadmap entry the community votes on. Feedback items link into one,
/// which is how "senin önerin" knows a row came from the viewer.
model RoadmapItem {
  id          String         @id @default(uuid())
  title       String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  versionLabel String?       @db.VarChar(24)
  status      FeedbackStatus @default(REVIEWING)
  /// Ascending display order; ties fall back to newest first.
  position    Int            @default(0)
  featured    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  feedback Feedback[]
  votes    RoadmapVote[]

  @@index([status, position])
  @@index([featured, position])
}

model RoadmapVote {
  id            String   @id @default(uuid())
  roadmapItemId String
  userId        String
  createdAt     DateTime @default(now())

  roadmapItem RoadmapItem @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roadmapItemId, userId])
  @@index([userId])
}

model FriendRequest {
  id         String       @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
  /// Friend lookups filter ACCEPTED requests through both sides of an OR.
  @@index([senderId, status])
  /// Friend lookups filter ACCEPTED requests through both sides of an OR.
  @@index([receiverId, status])
}

model Server {
  id                          String                @id @default(uuid())
  name                        String
  shortName                   String?               @db.VarChar(4)
  description                 String?
  iconUrl                     String?
  iconHash                    String?
  bannerUrl                   String?
  splashUrl                   String?
  ownerId                     String
  inviteCode                  String                @unique @map("invite_code") @db.VarChar(8)
  isPublic                    Boolean               @default(false)
  discoverable                Boolean               @default(false)
  verificationLevel           VerificationLevel     @default(NONE)
  defaultNotifications        NotificationLevel     @default(ALL_MESSAGES)
  explicitContentFilter       ExplicitContentFilter @default(DISABLED)
  systemChannelId             String?
  rulesChannelId              String?
  maxMembers                  Int                   @default(500000)
  preferredLocale             String                @default("en") @db.VarChar(10)
  boostLevel                  Int                   @default(0)
  boostCount                  Int                   @default(0)
  vanityUrlCode               String?               @unique @map("vanity_url_code")
  afkChannelId                String?
  afkTimeout                  Int                   @default(300)
  type                        ServerType            @default(PERSONAL)
  memberCount                 Int                   @default(0)
  features                    String[]
  /// Discovery labels, distinct from `features`: `features` is a capability
  /// flag list the product writes (VERIFIED, FEATURED, TEXT_GIFS_DISABLED),
  /// these are owner-authored slugs the discovery search matches on. Shape
  /// (lowercase slug, 1..24 chars, max 5) is enforced in `@wizards/types`;
  /// the column is a plain array.
  tags                        String[]
  /// Keşfet dizininin tek sınıflandırma ekseni. `null` = sahibi henüz seçmedi:
  /// the server still shows under "Tümü", never matches a category filter, and
  /// is left out of the per-category counters.
  category                    ServerCategory?
  /// The featured block's "Türkçe · İngilizce" pill. Distinct from
  /// `preferredLocale`, which is a single value and drives notification and
  /// formatting language; this column lists the languages actually spoken in the
  /// server. BCP-47 short codes, at most 4 entries — shape enforced in
  /// `@wizards/types`, the column is a plain array like `tags`.
  languages                   String[]
  messageCharacterLimit       Int                   @default(2000)
  deletedMessageNoticeMinutes Int                   @default(60)
  /// Sunucu ikonunun renk tonu. `null` = eski deterministik türetme (kısa adın harf
  /// kodları toplamı % palet uzunluğu). Geri doldurma yapılmaz; mevcut sunucuların
  /// görünümü değişmez. Değer kümesi `SERVER_ICON_TONES` ile sınırlıdır ve
  /// `@wizards/types` tarafında zorlanır; kolon düz metin taşır.
  iconColor                   String?
  /// Sunucu geneli yavaş mod, saniye. `Channel.slowModeDelay` ile aynı değer kümesini
  /// paylaşır; uygulama kuralı max(server, channel) ve tek yerde yaşar.
  slowModeDelay               Int                   @default(0)
  authorizationRevision       BigInt                @default(0)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  owner              User                 @relation("ServerOwner", fields: [ownerId], references: [id])
  members            ServerMember[]
  roles              Role[]
  bans               ServerBan[]
  invites            ServerInvite[]
  channels           Channel[]            @relation("ChannelServer")
  categories         ChannelCategory[]
  emojis             Emoji[]
  webhooks           Webhook[]            @relation("ServerWebhooks")
  auditLogs          AuditLog[]
  scheduledEvents    ScheduledEvent[]
  voiceStates        VoiceState[]         @relation("VoiceStateServer")
  mediaUsageSessions MediaUsageSession[]
  userServerSettings UserServerSettings[] @relation("ServerUserSettings")
  authorizationSubjectRevisions ServerAuthorizationSubjectRevision[]

  @@index([name])
  @@index([ownerId])
  @@index([discoverable])
  /// S3: the discovery query filters on `discoverable`/`isPublic` (not
  /// `type` -- both PERSONAL and COMMUNITY servers can be discoverable) and
  /// orders by `memberCount desc`. The S1 index `[type, discoverable,
  /// memberCount]` could not serve that query: `type` unfiltered meant the
  /// leading column bought nothing, and `isPublic` was not a member of that
  /// index at all. `EXPLAIN` against a seeded local DB confirmed a
  /// sequential scan on the old index alone; this one is what the discovery
  /// query actually uses. The dead S1 index was dropped
  /// (20260808130000_drop_server_type_discoverable_index) once a repo-wide
  /// grep confirmed no query anywhere filters on `Server.type`.
  @@index([discoverable, isPublic, memberCount])
  /// Keşfet's category-filtered directory query: `WHERE category = ? AND
  /// discoverable AND isPublic ORDER BY memberCount DESC`. The index above does
  /// not carry `category`, so with a category selected Postgres would walk the
  /// whole discoverable set and drop rows one at a time. The column order keeps
  /// `memberCount` last so the ordering is read straight off the index.
  @@index([category, discoverable, isPublic, memberCount])
  /// The discovery search matches a tag with an array-containment test
  /// (`tags @> ARRAY[...]`), which a B-tree cannot serve at all. GIN is the
  /// only index type Postgres offers for that operator on `text[]`.
  @@index([tags], type: Gin)
}

