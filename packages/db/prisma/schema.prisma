model MessageMention {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  /// Ana Sayfa 1a, Faz 3. Denormalized from the message so "my mentions" can be
  /// answered from one index instead of joining every mention this user ever
  /// received and sorting the result. Measured on 2M messages / 400k mentions:
  /// 213 buffers vs 21 454, 0.15 ms vs 22.6 ms.
  createdAt DateTime @default(now())
  /// Bahsedilmeler Ş0.2. Satırın hangi yoldan doğduğu — akış tür pilini ve `Türe göre`
  /// daraltmasını bu kolon sürer. Mevcut satırların hepsi kullanıcı adı eşleşmesinden geldiği
  /// için varsayılan `SELF` geçmişi doğru anlatır ve geri doldurma gerektirmez.
  kind      MentionKind @default(SELF)
  /// `kind = ROLE` olduğunda bahsedilen rol. Rol silinirse satır kalır ve bahsetme "rol"
  /// olmayı sürdürür; bahsetme olan bir şey, adı taşıyan kayıt gittiğinde olmamış olmaz.
  roleId    String?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([userId, createdAt])
  /// `Türe göre` daraltması tür + zaman sorar; iki kolonlu indeks olmadan bu sorgu
  /// `userId, createdAt` indeksini tarayıp türü sonradan eler.
  @@index([userId, kind, createdAt])
  @@index([roleId])
}

/// Ana Sayfa 1a, Faz 6. The DM twin of `MessageMention`.
///
/// Before this table a direct-message mention existed only as an increment on
/// `DMParticipant.mentionCount`: a number, with no row behind it. "Bahsedilmeler"
/// lists individual mentions, so the counter could answer "how many" but never
/// "which ones" — the `Mesajlar` filter would have been permanently empty.
///
/// `createdAt` is denormalized from the message for the same measured reason
/// the channel side carries it: the screen's keyset page must be O(page), not
/// O(every mention this user ever received).
model DMMessageMention {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())
  /// Bahsedilmeler Ş0.2. DM'de rol ve `@herkes` yoktur; kolon yine de kanal ikizi ile aynı
  /// şekli taşısın diye duruyor — akış iki tabloyu tek `UNION` ile okur ve dalların kolon
  /// listesi ayrışırsa sorgu her eklemede yeniden yazılır.
  kind      MentionKind @default(SELF)

  message DMMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

/// Bahsedilmeler Ş0.2 — bir bahsetmenin **okunma ve triyaj** durumu (karar K4/K5).
///
/// Neden ayrı tablo: ekranın dört dalı dört farklı satıra dayanıyor (`MessageMention`,
/// `DMMessageMention`, `Message.mentionEveryone`, thread yanıtı). Okundu bilgisini her dalın
/// kendi tablosunda tutmak dört ayrı "okundu" demekti; `@herkes` dalının ise yazacağı bir
/// satırı yok. Tek tablo, dört kaynak, tek doğruluk.
///
/// Satır **tembel** doğar: hiç dokunulmamış bir bahsetmenin burada kaydı yoktur ve okunma
/// durumu `Notification` satırından okunur (bkz. `mentions-service`: bildirim satırı olmayan
/// bahsetme okunmuş sayılır, çünkü hiçbir zaman bekleyen olmamıştır).
model MentionState {
  id          String             @id @default(uuid())
  userId      String
  source      MentionStateSource
  refId       String
  /// Okundu anı. `null` = okunmamış. `Okunmadı işaretle` bu alanı `null`'a döndürür.
  readAt      DateTime?
  /// "Sonra oku" (K5): kart okunmamış kalır ve akışın en üstünde sabitlenir. Süre sınırı yok.
  readLaterAt DateTime?
  /// "Listeden kaldır": kart akıştan düşer. Mesaj silinmez — bu bir görünürlük kararıdır.
  dismissedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, refId])
  /// Sayaç sorgusu okunmamışları sayar.
  @@index([userId, readAt])
  /// "Sonra oku" grubu akışın başında ayrı sorgulanır.
  @@index([userId, readLaterAt])
}

/// Bahsedilmeler Ş0.2 — thread takibi (karar K3).
///
/// Bugüne kadar thread yanıtı yalnız **üst mesajın yazarına** bildirim üretiyordu; "takip
/// ettiğin thread'ler" diye bir kavram yoktu. Takip örtük olarak doğar (thread'i açan, içine
/// yanıt yazan, içinde bahsedilen) ve açıkça kapatılabilir.
///
/// Kapatma satırı **silmez**, `mutedAt` yazar: silinseydi bir sonraki örtük tetikleyici
/// (ör. kullanıcının thread'e ikinci yanıtı) takibi sessizce geri açardı.
model ThreadFollow {
  id              String             @id @default(uuid())
  userId          String
  /// Thread'in anahtarı `Message.threadParentId`dir; `Message.threadId` ayrı bir kanal
  /// ilişkisidir ve bildirim yolu üst mesaj kimliğiyle çalışır.
  parentMessageId String
  /// Görünürlük süzgeci için denormalize: takipçi kümesi kanal iznine göre elenir ve bu
  /// eleme, üst mesajı ayrıca okumadan yapılabilmeli.
  channelId       String
  origin          ThreadFollowOrigin
  mutedAt         DateTime?
  createdAt       DateTime           @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent Message @relation("ThreadFollowParent", fields: [parentMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, parentMessageId])
  /// Fan-out: "bu thread'i kim takip ediyor?"
  @@index([parentMessageId])
  /// Akış: "bu kullanıcının takip ettiği thread'ler".
  @@index([userId, createdAt])
}

