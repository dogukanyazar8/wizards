model Message {
  id                   String      @id @default(uuid())
  channelId            String
  userId               String
  content              String      @db.Text
  type                 MessageType @default(DEFAULT)
  replyToId            String?
  threadParentId       String?
  threadId             String?
  alsoSentToChannel    Boolean     @default(false)
  mentionEveryone      Boolean     @default(false)
  isPinned             Boolean     @default(false)
  pinnedAt             DateTime?
  pinnedById           String?
  flags                Int         @default(0)
  forwardedAt          DateTime?
  editedAt             DateTime?
  deletedAt            DateTime?
  deletedById          String?
  placeholderRemovedAt DateTime?
  placeholderExpiresAt DateTime?
  tts                  Boolean     @default(false)
  webhookId            String?
  /// Minted per send by the author's client and echoed back to them. Unique per
  /// author so a retried send — a dropped response, an offline replay, a double
  /// tap — resolves to the message that already exists instead of a second one.
  clientNonce          String?     @db.VarChar(128)
  createdAt            DateTime    @default(now())

  channel       Channel          @relation("MessageChannel", fields: [channelId], references: [id], onDelete: Cascade)
  author        User             @relation("MessageAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reply         Message?         @relation("MessageReply", fields: [replyToId], references: [id], onDelete: Restrict)
  replies       Message[]        @relation("MessageReply")
  threadParent  Message?         @relation("MessageThreadParent", fields: [threadParentId], references: [id], onDelete: Cascade)
  threadReplies Message[]        @relation("MessageThreadParent")
  thread        Channel?         @relation("MessageThread", fields: [threadId], references: [id], onDelete: Cascade)
  mentions      MessageMention[]
  reactions     Reaction[]
  attachments   Attachment[]     @relation("MessageAttachment")
  pinned        PinnedMessage[]

  content_search Unsupported("tsvector")? @map("content_search")

  @@index([channelId, createdAt])
  @@index([channelId, alsoSentToChannel, createdAt])
  @@index([channelId, threadParentId, createdAt])
  @@index([channelId, threadId, createdAt])
  @@index([channelId, placeholderRemovedAt])
  @@index([channelId, placeholderRemovedAt, placeholderExpiresAt])
  @@index([threadParentId, createdAt])
  @@index([userId])
  @@unique([userId, clientNonce])
}

