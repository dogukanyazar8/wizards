enum ClientHealthKind {
  STARTUP
  SCREEN_LOAD
  CRASH
  ERROR
  API_LATENCY
}

/// Raw client health signals. Kept apart from `UserDailyMetric` because the
/// shape, the volume and the retention are all different: these arrive in
/// bursts and are rolled up into `ClientHealthDailySummary` after 30 days.
model ClientHealthEvent {
  id         String              @id @default(uuid())
  userId     String?
  clientType AnalyticsClientType @default(UNKNOWN)
  appVersion String?             @db.VarChar(32)
  os         String?             @db.VarChar(32)
  kind       ClientHealthKind
  surface    String?             @db.VarChar(64)
  valueMs    Int?
  context    Json?
  /// Stamped per measurement by the client. Unique so a retried flush cannot
  /// count the same sample twice.
  sampleId   String?             @unique @db.VarChar(64)
  createdAt  DateTime            @default(now())

  user User? @relation("ClientHealthEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([clientType, kind, createdAt])
  @@index([appVersion, kind, createdAt])
}

/// What survives the 30-day rollup: counts and latency percentiles per day,
/// platform, version and kind.
model ClientHealthDailySummary {
  id         String              @id @default(uuid())
  date       DateTime            @db.Date
  clientType AnalyticsClientType @default(UNKNOWN)
  /// Empty string when the client did not report one: a NULL here would make
  /// every rollup row distinct under the unique index and duplicate the summary.
  appVersion String              @default("") @db.VarChar(32)
  kind       ClientHealthKind
  /// Empty string for kinds that have no surface (crashes, errors). Part of the
  /// unique key: a percentile pooled across surfaces is not actionable.
  surface    String              @default("") @db.VarChar(64)
  count      Int                 @default(0)
  p50Ms      Int?
  p95Ms      Int?
  p99Ms      Int?
  createdAt  DateTime            @default(now())

  @@unique([date, clientType, appVersion, kind, surface])
  @@index([date, kind])
}

model FeatureFlag {
  key            String                @id @db.VarChar(64)
  description    String?               @db.VarChar(280)
  enabled        Boolean               @default(false)
  /// Empty means every platform. Otherwise only the listed ones.
  clientTypes    AnalyticsClientType[]
  /// 0-100. Stable per user through a hash of the key and the user id.
  rolloutPercent Int                   @default(100)
  updatedById    String?
  updatedAt      DateTime              @updatedAt
  createdAt      DateTime              @default(now())

  updatedBy User? @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

enum PushAttemptStage {
  TICKET
  RECEIPT
}

model PushDeliveryAttempt {
  id             String           @id @default(uuid())
  userId         String?
  campaignId     String?
  notificationId String?
  platform       String           @db.VarChar(16)
  stage          PushAttemptStage @default(TICKET)
  /// Expo ticket id; a receipt lookup is matched through it.
  ticketId       String?          @db.VarChar(64)
  success        Boolean
  errorCode      String?          @db.VarChar(64)
  createdAt      DateTime         @default(now())

  user     User?                 @relation("PushDeliveryAttemptUser", fields: [userId], references: [id], onDelete: SetNull)
  campaign NotificationCampaign? @relation("PushDeliveryAttemptCampaign", fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId, success])
  @@index([platform, stage, createdAt])
  @@index([errorCode, createdAt])
  @@index([ticketId])
}

enum ClusterSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A proposal, never an action: clustering suggests which feedback rows look
/// like the same request, and an operator decides. Nothing here links a
/// `Feedback` to a roadmap item on its own.
model FeedbackClusterSuggestion {
  id           String                  @id @default(uuid())
  topic        FeedbackTopic
  feedbackIds  Json
  score        Float                   @default(0)
  status       ClusterSuggestionStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime                @default(now())

  resolvedBy User? @relation("FeedbackClusterResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, score])
  @@index([topic, createdAt])
}

/// Which build stream a release belongs to. `UAT` is an internal stream, so it
/// is never the default a new account lands on.
enum ReleaseChannel {
  STABLE
  BETA
  UAT
}

enum ReleaseChangeType {
  NEW
  IMPROVED
  FIXED
}

enum MobileUpdatePlatform {
  ANDROID
  IOS
}

enum ReleaseArtifactKind {
  APK
  AAB
  IPA
}

enum HelpCategory {
  ACCOUNT
  CHAT
  MEDIA
  SERVER
}

enum BugReportCategory {
  VOICE
  CHAT
  NOTIFICATION
  PERFORMANCE
  OTHER
}

enum BugReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISCARDED
}

/// One shipped app version. The "Yenilikler" card, the release history and the
/// update banner all read this table, so a version the team has not announced
/// yet must stay invisible rather than live behind a client-side filter:
/// `publishedAt = NULL` is a draft and no mobile endpoint returns it.
model Release {
  id          String         @id @default(uuid())
  /// Semver text, for example "0.8.15". Unique because the detail route and the
  /// installed-version comparison both address a release by it.
  version     String         @unique @db.VarChar(32)
  codename    String?        @db.VarChar(48)
  channel     ReleaseChannel @default(STABLE)
  releasedAt  DateTime
  buildNumber Int?
  /// Download size of the build. BigInt in the column, plain number on the wire.
  sizeBytes   BigInt?
  /// The paragraph 2a prints under the version heading.
  summary     String?        @db.VarChar(600)
  /// One line for the history row; shorter than `summary` on purpose.
  highlight   String?        @db.VarChar(160)
  mandatory   Boolean        @default(false)
  /// Old native builds below this code must install a new binary before OTA.
  minSupportedVersionCode Int?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  artifacts  ReleaseArtifact[]
  changes    ReleaseChange[]
  otaBundles OtaBundle[]

  @@index([publishedAt, releasedAt])
  @@index([channel, releasedAt])
}

/// Immutable, pre-signed Expo update publication metadata. The signing private
/// key is deliberately absent: publication signs offline before this row exists.
model OtaBundle {
  id                         String               @id @default(uuid())
  releaseId                  String
  platform                   MobileUpdatePlatform
  channel                    ReleaseChannel
  runtimeVersion             String               @db.VarChar(256)
  bundleKey                  String               @unique @db.VarChar(512)
  manifestBody               String
  manifestSignature          String
  manifestSha256             String               @db.VarChar(64)
  noUpdateDirectiveBody      String
  noUpdateDirectiveSignature String
  rollbackDirectiveBody      String
  rollbackDirectiveSignature String
  signingKeyId               String               @db.VarChar(128)
  rolloutPercentage          Int                  @default(100)
  enabled                    Boolean              @default(true)
  publishedAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([platform, channel, runtimeVersion, publishedAt])
}

/// A native package registered only after CI verifies its bytes and Android
/// signing certificate. Store builds never receive an internal APK URL.
model ReleaseArtifact {
  id                String               @id @default(uuid())
  releaseId         String
  channel           ReleaseChannel
  platform          MobileUpdatePlatform
  kind              ReleaseArtifactKind
  versionCode       Int
  url               String               @db.VarChar(2048)
  sizeBytes         BigInt
  sha256            String               @db.VarChar(64)
  signingCertSha256 String?              @db.VarChar(95)
  publishedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([platform, kind, channel, versionCode])
  @@index([releaseId])
  @@index([platform, kind, channel, versionCode, publishedAt])
}

/// A single line of a release note. `position` orders within a type group, so
/// 2a can render "YENİ · 2" then "İYİLEŞTİRME · 3" without sorting on the client.
model ReleaseChange {
  id        String            @id @default(uuid())
  releaseId String
  type      ReleaseChangeType
  title     String            @db.VarChar(200)
  detail    String?           @db.VarChar(600)
  position  Int               @default(0)

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, type, position])
}

/// A help centre entry. `bodyMarkdown` is optional: when it is empty the app
/// opens `url` in a browser instead of the in-app reader, which is what keeps
/// a long-form article from having to be duplicated here.
model HelpArticle {
  id           String       @id @default(uuid())
  slug         String       @unique @db.VarChar(120)
  title        String       @db.VarChar(200)
  category     HelpCategory
  readMinutes  Int
  viewCount    Int          @default(0)
  url          String       @db.VarChar(2048)
  bodyMarkdown String?
  publishedAt  DateTime?
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category, position])
  @@index([publishedAt, viewCount])
}

/// 2f "Sorun bildir". Deliberately separate from `Feedback`: that table is a
/// product suggestion queue with a roadmap and a public number the user tracks,
/// while this one carries logs, a screenshot and device details under a 90-day
/// deletion promise the screen makes in writing.
model BugReport {
  id                  String            @id @default(uuid())
  /// `WSP-#####`, quoted back in the submission toast and searched by support.
  ticket              String            @unique @db.VarChar(16)
  userId              String?
  category            BugReportCategory
  body                String            @db.VarChar(1000)
  includesLogs        Boolean
  includesScreenshot  Boolean
  includesDeviceInfo  Boolean
  /// Trimmed to the last 500 lines before it is stored; §4.10 promises no more.
  logExcerpt          String?
  /// Only written when `includesDeviceInfo` is true.
  deviceInfo          Json?
  screenshotUrl       String?           @db.VarChar(2048)
  appVersion          String?           @db.VarChar(32)
  appBuild            String?           @db.VarChar(32)
  releaseChannel      String?           @db.VarChar(16)
  platform            String?           @db.VarChar(16)
  status              BugReportStatus   @default(OPEN)
  createdAt           DateTime          @default(now())
  /// `createdAt + 90 days`. The purge job reads this column, so the promise is
  /// data rather than a rule someone has to remember.
  purgeAfter          DateTime

  user User? @relation("BugReportUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([purgeAfter])
  @@index([userId, createdAt])
}
