{
  "name": "@wizards/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:ensure-runtime": "node ./scripts/ensure-prisma-client-runtime.mjs",
    "db:seed": "node --loader ts-node/esm src/seed.ts",
    "contributors:sync": "node --loader ts-node/esm src/sync-contributors.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "echo db package ready",
    "lint": "prisma generate && tsc --noEmit",
    "typecheck": "prisma generate && tsc --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.1",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
