{
  "name": "@wizards/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:ensure-runtime": "node ./scripts/ensure-prisma-client-runtime.mjs",
    "db:seed": "node --loader ts-node/esm src/seed.ts",
    "contributors:sync": "node --loader ts-node/esm src/sync-contributors.ts",
    "build": "prisma generate && node ../../scripts/quality/typescript-project-runner.mjs --project=db --mode=build",
    "dev": "echo db package ready",
    "lint": "prisma generate && node ../../scripts/quality/typescript-project-runner.mjs --project=db --mode=check",
    "typecheck": "prisma generate && node ../../scripts/quality/typescript-project-runner.mjs --project=db --mode=check",
    "format": "node ../../scripts/quality/prettier-changed.mjs --scope packages/db"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "prettier": "3.9.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  }
}
