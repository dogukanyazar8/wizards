{
  "name": "@wizards/mobile",
  "version": "0.8.15",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:uat:local": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1",
    "android:uat:local:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -CleanAndroidCaches",
    "android:uat:local:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -NoStartMetro",
    "android:uat:local:apk:phone": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -NoStartMetro -AndroidArchitectures arm64-v8a,armeabi-v7a",
    "android:uat:local:apk:phone:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -NoStartMetro -BuildType release -AndroidArchitectures arm64-v8a,armeabi-v7a",
    "android:uat:local:apk:universal": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -NoStartMetro -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "android:uat:local:apk:universal:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -NoStartMetro -BuildType release -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "ios": "expo run:ios",
    "lint": "tsc --noEmit",
    "quality:check": "node --import tsx scripts/validate-mobile-quality.ts",
    "release:check": "node --import tsx scripts/validate-mobile-release.ts",
    "release:evidence": "node --import tsx scripts/write-mobile-release-evidence.ts",
    "test": "node --test --import tsx scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:env": "node --import tsx scripts/validate-mobile-env.ts"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@livekit/react-native": "^2.11.1",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.1",
    "@wizards/types": "workspace:*",
    "expo": "~56.0.12",
    "expo-dev-client": "~56.0.20",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.19",
    "expo-notifications": "~56.0.19",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "livekit-client": "^2.19.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
