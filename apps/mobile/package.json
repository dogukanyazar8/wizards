{
  "name": "@wizards/mobile",
  "version": "0.9.1",
  "private": true,
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "@shopify/flash-list",
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:uat:local": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1",
    "android:uat:local:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -CleanAndroidCaches",
    "android:uat:local:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -DisableGradleBuildCache -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "android:uat:local:apk:phone": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -AndroidArchitectures arm64-v8a,armeabi-v7a",
    "android:uat:local:apk:phone:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -BuildType release -RequireGoogleSignIn -AndroidArchitectures arm64-v8a,armeabi-v7a",
    "android:uat:local:apk:universal": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -DisableGradleBuildCache -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "android:uat:local:apk:universal:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -BuildType release -RequireGoogleSignIn -DisableGradleBuildCache -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "ios": "expo run:ios",
    "lint": "node ../../scripts/quality/typescript-project-runner.mjs --project=mobile --mode=check",
    "google:doctor": "node --import tsx scripts/google-signin-doctor.ts",
    "licenses:generate": "node --import tsx scripts/generate-mobile-open-source-licenses.ts",
    "quality:check": "node --import tsx scripts/validate-mobile-quality.ts",
    "release:check": "node --import tsx scripts/validate-mobile-release.ts",
    "release:evidence": "node --import tsx scripts/write-mobile-release-evidence.ts",
    "test": "node --test --import tsx scripts/*.test.ts",
    "test:components": "jest --maxWorkers=2",
    "typecheck": "node ../../scripts/quality/typescript-project-runner.mjs --project=mobile --mode=check",
    "validate:env": "node --import tsx scripts/validate-mobile-env.ts",
    "visual:capture:android": "node --import tsx scripts/mobile-redesign-device-capture.ts --platform android",
    "visual:capture:ios": "node --import tsx scripts/mobile-redesign-device-capture.ts --platform ios",
    "visual:diff": "node --import tsx scripts/mobile-redesign-diff.ts",
    "visual:gate": "node --import tsx scripts/mobile-redesign-visual-gate.ts",
    "lint:hooks": "eslint ."
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/vector-icons": "^15.1.1",
    "@livekit/react-native": "^3.0.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "144.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/cli": "3.8.0",
    "@sentry/react-native": "^8.27.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "5.103.2",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-persist-client": "5.103.2",
    "@uploadthing/react": "7.3.3",
    "@wizards/types": "workspace:*",
    "expo": "~57.0.24",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "js-sha256": "1.0.0",
    "livekit-client": "^2.22.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "uploadthing": "7.7.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "19.2.18",
    "babel-preset-expo": "~57.0.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "pixelmatch": "7.2.0",
    "react-dom": "19.2.3",
    "sharp": "0.35.4",
    "ssim.js": "4.0.1",
    "test-renderer": "1.2.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0"
  }
}
