{
  "name": "@wizards/mobile",
  "version": "0.8.15",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:uat:local": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1",
    "android:uat:local:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -CleanAndroidCaches",
    "android:uat:local:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "android:uat:local:apk:phone": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -AndroidArchitectures arm64-v8a,armeabi-v7a",
    "android:uat:local:apk:phone:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -BuildType release -AndroidArchitectures arm64-v8a,armeabi-v7a",
    "android:uat:local:apk:universal": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "android:uat:local:apk:universal:release": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-uat.ps1 -SkipInstall -SkipUninstall -NoStartMetro -BuildType release -AndroidArchitectures armeabi-v7a,arm64-v8a,x86,x86_64",
    "ios": "expo run:ios",
    "lint": "tsc --noEmit",
    "quality:check": "node --import tsx scripts/validate-mobile-quality.ts",
    "release:check": "node --import tsx scripts/validate-mobile-release.ts",
    "release:evidence": "node --import tsx scripts/write-mobile-release-evidence.ts",
    "test": "node --test --import tsx scripts/*.test.ts",
    "test:components": "jest",
    "typecheck": "tsc --noEmit",
    "validate:env": "node --import tsx scripts/validate-mobile-env.ts"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@livekit/react-native": "^2.11.1",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.99.2",
    "@wizards/types": "workspace:*",
    "expo": "~56.0.15",
    "expo-clipboard": "~56.0.4",
    "expo-dev-client": "~56.0.22",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.20",
    "expo-local-authentication": "~56.0.4",
    "expo-navigation-bar": "~56.0.3",
    "expo-notifications": "~56.0.20",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.21",
    "livekit-client": "^2.19.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.14.1",
    "@types/react": "~19.2.2",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "test-renderer": "1.2.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}
