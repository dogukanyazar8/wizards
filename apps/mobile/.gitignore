# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
google-services.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
# Private signing keys stay local. The public UAT OTA trust root is required
# in shipped UAT binaries so Expo can verify signed manifests.
*.pem
!certs/
!certs/ota/
!certs/ota/uat/
!certs/ota/uat/certificate.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
