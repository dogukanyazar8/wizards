{
  "name": "@wizards/web",
  "version": "0.8.15",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && tsx watch server.ts",
    "build": "pnpm --filter @wizards/db db:generate && node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && next build && pnpm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "db:migrate:deploy": "pnpm --filter @wizards/db db:migrate:deploy",
    "dev:clear-auth-rate-limits": "tsx scripts/clear-auth-rate-limits.ts",
    "start": "node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && node dist/server.js",
    "start:outbox-worker": "node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && node dist/outbox-worker.js",
    "start:with-migrations": "pnpm run db:migrate:deploy && pnpm run start",
    "e2e": "pnpm run e2e:check-env && playwright test",
    "e2e:api": "pnpm run e2e:check-env && playwright test e2e/specs/api",
    "e2e:check-env": "tsx scripts/check-e2e-env.ts",
    "e2e:headed": "pnpm run e2e:check-env && playwright test --headed",
    "e2e:mobile": "pnpm run e2e:check-env && playwright test e2e/specs/mobile",
    "e2e:report": "playwright show-report",
    "e2e:realtime": "pnpm run e2e:check-env && playwright test e2e/specs/realtime e2e/specs/voice",
    "e2e:seed": "pnpm run e2e:check-env && node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && tsx e2e/setup/reset-and-seed.ts",
    "e2e:smoke": "pnpm run e2e:check-env && playwright test e2e/specs/smoke",
    "e2e:ui": "pnpm run e2e:check-env && playwright test --ui",
    "e2e:web-server": "pnpm run build:server && pnpm start",
    "lint": "eslint .",
    "maintenance:cleanup-reauth": "node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && tsx scripts/cleanup-account-reauth-challenges.ts",
    "test": "node scripts/run-node-tests.mjs",
    "test:coverage": "c8 --all --reporter=text --reporter=json-summary --include=\"src/**/*.ts\" --include=\"src/**/*.tsx\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/**/*.test.tsx\" --check-coverage --lines=20 --branches=61 --functions=44 node scripts/run-node-tests.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@livekit/components-core": "^0.12.13",
    "@livekit/components-react": "^2.9.21",
    "@livekit/krisp-noise-filter": "^0.4.3",
    "@prisma/client": "5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uploadthing/react": "^7.3.3",
    "@wizards/db": "workspace:*",
    "@wizards/types": "workspace:*",
    "@wizards/ui": "workspace:*",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.42.2",
    "ioredis": "^5.11.1",
    "livekit-client": "^2.20.0",
    "livekit-server-sdk": "^2.16.0",
    "lucide-react": "^0.511.0",
    "next": "^15.5.18",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.4",
    "parse5": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.16.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "uploadthing": "^7.7.4",
    "zod": "^3.24.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "15.5.18",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.5.2",
    "c8": "10.1.3",
    "esbuild": "0.28.1",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
