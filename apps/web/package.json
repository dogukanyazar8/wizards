{
  "name": "@wizards/web",
  "version": "0.8.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && tsx watch server.ts",
    "build": "pnpm --filter @wizards/db db:generate && node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && next build",
    "db:migrate:deploy": "pnpm --filter @wizards/db db:migrate:deploy",
    "start": "node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && tsx server.ts",
    "start:with-migrations": "pnpm run db:migrate:deploy && pnpm run start",
    "e2e": "playwright test",
    "e2e:api": "playwright test e2e/specs/api",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:realtime": "playwright test e2e/specs/realtime e2e/specs/voice",
    "e2e:seed": "node ../../packages/db/scripts/ensure-prisma-client-runtime.mjs && tsx e2e/setup/reset-and-seed.ts",
    "e2e:smoke": "playwright test e2e/specs/smoke",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-force-exit src/**/*.test.ts",
    "test:coverage": "c8 --all --reporter=text --reporter=json-summary --include=\"src/**/*.ts\" --include=\"src/**/*.tsx\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/**/*.test.tsx\" --check-coverage --lines=20 --branches=61 --functions=44 node --import tsx --test --test-force-exit src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@livekit/components-core": "^0.12.13",
    "@livekit/components-react": "^2.9.20",
    "@livekit/krisp-noise-filter": "^0.3.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.75.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@uploadthing/react": "^7.3.3",
    "@wizards/db": "workspace:*",
    "@wizards/types": "workspace:*",
    "@wizards/ui": "workspace:*",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "livekit-client": "^2.18.7",
    "livekit-server-sdk": "^2.15.2",
    "lucide-react": "^0.511.0",
    "next": "^15.5.18",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.4",
    "parse5": "^8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.2.0",
    "uploadthing": "^7.7.4",
    "zod": "^3.24.4",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "15.5.18",
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "c8": "10.1.3",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
