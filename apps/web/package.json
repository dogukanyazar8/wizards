{
  "name": "@wizards/web",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 128",
    "Safari >= 16.4"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env server.ts",
    "build": "pnpm --filter @wizards/db db:generate && node scripts/build-next.mjs && pnpm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "db:migrate:deploy": "pnpm --filter @wizards/db db:migrate:deploy",
    "dev:clear-auth-rate-limits": "tsx scripts/clear-auth-rate-limits.ts",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/server.js",
    "start:outbox-worker": "node --enable-source-maps --import ./dist/instrument.js dist/outbox-worker.js",
    "start:with-migrations": "pnpm run db:migrate:deploy && pnpm run start",
    "e2e": "pnpm run e2e:check-env && playwright test --project=chromium",
    "e2e:a11y": "pnpm run e2e:check-env && playwright test --project=chromium e2e/specs/a11y",
    "e2e:api": "pnpm run e2e:check-env && playwright test --project=chromium e2e/specs/api",
    "e2e:check-env": "tsx scripts/check-e2e-env.ts",
    "e2e:headed": "pnpm run e2e:check-env && playwright test --project=chromium --headed",
    "e2e:mobile": "pnpm run e2e:check-env && playwright test --project=chromium e2e/specs/mobile",
    "e2e:report": "playwright show-report",
    "e2e:real-media": "pnpm run e2e:check-env && playwright test --project=chromium-real-media",
    "e2e:realtime": "pnpm run e2e:check-env && playwright test --project=chromium e2e/specs/realtime e2e/specs/voice",
    "e2e:seed": "pnpm run e2e:check-env && tsx e2e/setup/reset-and-seed.ts",
    "e2e:smoke": "pnpm run e2e:check-env && playwright test --project=chromium e2e/specs/smoke",
    "e2e:smoke:cross-browser": "pnpm run e2e:check-env && playwright test --project=firefox e2e/specs/smoke && playwright test --project=webkit e2e/specs/smoke",
    "e2e:ui": "pnpm run e2e:check-env && playwright test --project=chromium --ui",
    "e2e:visual": "pnpm run e2e:check-env && playwright test --project=chromium e2e/specs/visual",
    "e2e:web-server": "pnpm run build && pnpm start",
    "lint": "node --test scripts/eslint-config.test.mjs scripts/dev-env-contract.test.mjs scripts/build-next.test.mjs scripts/playwright-real-media-config.test.mjs && eslint .",
    "maintenance:cleanup-reauth": "tsx scripts/cleanup-account-reauth-challenges.ts",
    "maintenance:server-member-counts": "tsx scripts/repair-server-member-counts.ts",
    "maintenance:totp-secrets": "tsx scripts/backfill-totp-secrets.ts",
    "test": "node scripts/run-node-tests.mjs",
    "test:voice-audio": "node --test scripts/voice-audio-renderer.test.mjs",
    "test:coverage": "tsx scripts/run-coverage.ts",
    "typecheck": "node ../../scripts/quality/typescript-project-runner.mjs --project=web --mode=check",
    "format": "node ../../scripts/quality/prettier-changed.mjs --scope apps/web"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@livekit/components-react": "^2.9.24",
    "@livekit/krisp-noise-filter": "^0.4.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "@sentry/nextjs": "10.75.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "2.12.4",
    "@uploadthing/react": "^7.3.3",
    "@wizards/db": "workspace:*",
    "@wizards/types": "workspace:*",
    "@wizards/ui": "workspace:*",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^13.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "parse5": "^8.0.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "16.4.2",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.0"
  }
}
