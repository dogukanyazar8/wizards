{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whispr",
  "version": "0.5.0",
  "identifier": "com.whispr.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://whispr.example.com",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "whispr-desktop-native-ux",
          "description": "Whispr remote web content receives only the minimal Tauri permissions required for native desktop UX.",
          "windows": ["main"],
          "remote": {
            "urls": ["http://localhost:3000", "http://127.0.0.1:3000"]
          },
          "permissions": [
            "notification:allow-is-permission-granted",
            "notification:allow-notify",
            "notification:allow-request-permission"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Whispr",
    "copyright": "Copyright (c) 2026 Whispr",
    "category": "SocialNetworking",
    "shortDescription": "Whispr desktop shell",
    "longDescription": "A secure Tauri desktop shell for the existing Whispr web app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Whispr"
      }
    }
  }
}
