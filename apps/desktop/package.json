{
  "name": "@wizards/desktop",
  "version": "0.8.15",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node ./scripts/run-tauri.mjs dev",
    "build:desktop": "node ./scripts/run-tauri.mjs build",
    "build:desktop:config": "node ./scripts/run-tauri.mjs build --write-config-only",
    "lint:rust": "cargo clippy --manifest-path ./src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "release:audit": "node ./scripts/release-audit.mjs",
    "release:artifacts": "node ./scripts/desktop-release-artifacts.mjs",
    "release:cargo-audit-summary": "node ./scripts/cargo-audit-summary.mjs",
    "release:manifest": "node ./scripts/create-update-manifest.mjs",
    "release:ops": "node ./scripts/release-ops.mjs",
    "release:promotion": "node ./scripts/release-promotion.mjs",
    "release:publish-plan": "node ./scripts/desktop-release-publish-plan.mjs",
    "release:validate-manifest": "node ./scripts/validate-update-manifest.mjs",
    "release:workflow": "node ./scripts/desktop-release-workflow.mjs",
    "test": "node --test scripts/*.test.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
